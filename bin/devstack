#!/usr/bin/env bash
# devstack — levanta, mira y baja stacks de desarrollo locales con un solo comando.
#
# Cada proyecto se declara en un JSON (~/.config/devstack/<proyecto>.json):
# servicios docker o de proceso, puerto, health-check, tareas extra. El script
# orquesta docker, los servidores de desarrollo y el navegador; los servicios
# viven en un pidfile propio para que `down` no deje nada huérfano y para no
# tocar nunca un proceso que hayas levantado tú a mano.
#
# Uso:
#   devstack                          lista los proyectos configurados
#   devstack <p> [up]                 levanta todo y abre el navegador
#                                     si otro proyecto tiene el puerto, mueve el
#                                     de ESTE; --force además libera lo ajeno
#   devstack <p> down                 baja los procesos y los servicios docker
#                                     --keep-docker lo deja, --force libera puertos
#   devstack <p> restart [id...]      reinicia (todos o los ids dados)
#   devstack <p> status               estado por servicio
#   devstack <p> json                 estado como JSON (lo consume el widget de la barra)
#   devstack <p> logs [id]            sigue los logs (o los últimos de todos)
#   devstack <p> open [id]            abre la URL del servicio (o la principal)
#   devstack <p> up <id...>           levanta sólo esos servicios (con dependencias)
#   devstack <p> task <id>            corre una tarea declarada (seed, migrate, …)
#   devstack <p> list                 servicios y tareas declarados
#   devstack <p> menu                 imprime el bloque JSONC para el menú de Omarchy
#   devstack <p> compose-file <svc>   imprime el compose aislado que usa `up`
#   devstack <p> --running            exit 0 si todos los servicios con health responden
#   devstack <p> --up                 exit 0 si todo escucha
#   devstack <p> --foreign            exit 0 si algún puerto lo tiene un proceso ajeno
#
#   devstack init <p>                 crea el JSON de un proyecto desde una plantilla
#   devstack scan <dir>               propone el stack de un repo (no escribe nada)
#   devstack <p> port [<svc>] [--to N|--auto] [--dry-run]
#                                     le cambia el puerto a un servicio (por
#                                     defecto elige uno libre) y lo escribe en su
#                                     url/health/cmd: sirve para correr dos stacks
#                                     que se pelean el mismo puerto
#   devstack add <dir> [--name <n>]   declara el stack que propone `scan`
#                                     (repetirlo sobre el mismo dir no rompe)
#   devstack all [status|json|up|down [--force]]
#                                     todos TUS proyectos de una vez; `down` baja
#                                     también los restos huérfanos y con --force
#                                     libera los puertos declarados
#   devstack here [cmd] [--window] [--fallback <p>] [--default]
#                                     el proyecto de la terminal activa (--window) o del
#                                     $PWD, y reenvía ahí cmd: status, up, down, logs…
#   devstack find [DIR...] [--json]   busca en tus carpetas los repos con stack
#                                     detectable (no escribe nada)
#   devstack lang [en|es]             idioma del widget (sin argumento, lo muestra)
#   devstack use [<p>|--clear]        proyecto de casa: el que se usa cuando no hay
#                                     otro (el widget lo usa si la terminal no está
#                                     en ningún proyecto declarado)
#   devstack pin [<p>|--clear|--show] proyecto fijado en la barra (ignora el foco);
#                                     es independiente de `use`
#   devstack menu --install|--ensure <p>|--remove
#                                     instala/verifica/quita la sección dev.* del
#                                     menú de Omarchy (el botón Menú usa --ensure)
#
# Overrides: DEVDATA_CONFIG (dir de configs) DEVDATA_PROJECT (proyecto por defecto)
#            DEVDATA_NOTIFY=all|final|off  (avisos de escritorio; el widget usa final)
#            DEVDATA_WAIT_SCALE (multiplica las esperas)

set -euo pipefail

# Configs: el proyecto del usuario manda; los ejemplos que viajan DENTRO del
# plugin quedan de respaldo (el plugin se instala clonando el repo entero, así
# que `omarchy plugin add` ya trae el CLI y los ejemplos de una sola vez).
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
USER_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/devstack"
BUNDLED_CONFIG_DIR="$SCRIPT_DIR/../config"
# Capa de detección (lib/scan.sh). Vive junto al CLI en el repo/plugin; si el
# CLI se copió suelto a ~/.local/bin, install.sh la deja en ~/.local/share/devstack.
SCAN_LIB=""
for cand in "$SCRIPT_DIR/../lib/scan.sh" "$SCRIPT_DIR/lib/scan.sh" \
    "${XDG_DATA_HOME:-$HOME/.local/share}/devstack/lib/scan.sh" "$HOME/.local/lib/devstack/scan.sh"; do
    [[ -r $cand ]] && { SCAN_LIB=$cand; break; }
done

CONFIG_DIRS=()
[[ -n ${DEVDATA_CONFIG:-} ]] && CONFIG_DIRS+=("$DEVDATA_CONFIG")
CONFIG_DIRS+=("$USER_CONFIG_DIR")
[[ -d $BUNDLED_CONFIG_DIR ]] && CONFIG_DIRS+=("$BUNDLED_CONFIG_DIR")
# Estado por usuario. XDG_RUNTIME_DIR ya es del usuario y 0700, así que se usa
# tal cual. Si no existe (contenedores, sesiones sin logind) se usa un directorio
# propio con el uid, pero verificado: se crea 0700, tiene que ser nuestro y se
# rechaza si alguien lo pre-creó como symlink. Una ruta predecible en /tmp la
# puede preparar otro usuario local para redirigir lo que escribimos.
runtime_base() {
    if [[ -n ${XDG_RUNTIME_DIR:-} && -d $XDG_RUNTIME_DIR ]]; then
        printf '%s/devstack' "$XDG_RUNTIME_DIR"
        return 0
    fi
    # Ojo: esto corre antes de que exista `die`, así que los errores se imprimen
    # acá mismo (y se corta con exit 1).
    local dir="${TMPDIR:-/tmp}/devstack-$(id -u)"
    local err=""
    if [[ -L $dir ]]; then
        err="el directorio de estado $dir es un symlink"
    elif [[ -e $dir && ! -O $dir ]]; then
        err="el directorio de estado $dir no es tuyo"
    fi
    if [[ -n $err ]]; then
        printf '\033[1;31m[error]\033[0m %s: borralo y reintentá\n' "$err" >&2
        exit 1
    fi
    mkdir -p -m 700 "$dir" 2>/dev/null || {
        printf '\033[1;31m[error]\033[0m no pude crear el directorio de estado %s\n' "$dir" >&2
        exit 1
    }
    chmod 700 "$dir" 2>/dev/null || true
    printf '%s' "$dir"
}
RUNTIME_BASE=$(runtime_base)
DEFAULT_PROJECT="${DEVDATA_PROJECT:-}"
WAIT_SCALE="${DEVDATA_WAIT_SCALE:-1}"
CURRENT=""
CONFIG_FILE=""
# Acción en curso y último mensaje de error: al salir se deja un archivo con el
# resultado, así el widget sabe que una acción terminó (bien o mal) en vez de
# quedarse "levantando" hasta el timeout.
ACTION=""
LAST_DETAIL=""

# ---------------------------------------------------------------- salida

log()  { printf '\033[1;34m[pos]\033[0m  %s\n' "$*"; }
ok()   { printf '\033[1;32m[ok]\033[0m   %s\n' "$*"; }
warn() { printf '\033[1;33m[aviso]\033[0m %s\n' "$*" >&2; }
die()  {
    LAST_DETAIL="$*"
    printf '\033[1;31m[error]\033[0m %s\n' "$*" >&2
    notify_result "Error: $*"
    exit 1
}

# Modo de avisos: `all` (cada etapa, por defecto), `final` (sólo el resultado)
# u `off`. El widget de la barra usa `final`: el panel ya muestra el progreso, y
# las notificaciones de cada etapa caían encima del propio panel.
NOTIFY_MODE="${DEVDATA_NOTIFY:-all}"

_notify() {
    command -v notify-send >/dev/null 2>&1 || return 0
    # Un estado de error se consulta cada pocos segundos (la barra hace `json`):
    # el mismo mensaje se avisa como mucho una vez por minuto, si no te llena de
    # notificaciones. Los mensajes distintos siempre pasan.
    local stamp="$RUNTIME_BASE/.last-notify" now last_at=0 last_msg=""
    now=$(date +%s)
    if [[ -r $stamp ]]; then
        IFS=$'\t' read -r last_at last_msg <"$stamp" || true
    fi
    [[ $last_at =~ ^[0-9]+$ ]] || last_at=0
    if [[ "$1" == "$last_msg" ]] && ((now - last_at < 60)); then
        return 0
    fi
    ensure_runtime 2>/dev/null || return 0
    printf '%s\t%s\n' "$now" "$1" >"$stamp" 2>/dev/null || true
    notify-send "${DEVDATA_NAME:-devstack}" "$1" >/dev/null 2>&1 || true
}

# Progreso (etapas): se calla en modo `final`.
notify() {
    [[ $NOTIFY_MODE == all ]] || return 0
    _notify "$1"
}

# Resultado (listo, parcial, error): pasa salvo en modo `off`.
notify_result() {
    [[ $NOTIFY_MODE == off ]] && return 0
    _notify "$1"
}

# El estado (pidfiles, logs) tiene que ser del usuario y privado. Si no hay
# XDG_RUNTIME_DIR caemos en /tmp/devstack-<uid> y lo verificamos antes de
# escribir: una ruta predecible en /tmp que otro usuario pueda pre-crear es
# justo lo que el baseline de seguridad del marketplace marca.
ensure_runtime() {
    if [[ ! -d $RUNTIME_BASE ]]; then
        mkdir -p "$RUNTIME_BASE" 2>/dev/null || die "No puedo crear $RUNTIME_BASE"
    fi
    [[ -O $RUNTIME_BASE ]] || die "$RUNTIME_BASE no es mío; no escribo ahí"
    chmod 700 "$RUNTIME_BASE" 2>/dev/null || true
}

# ---------------------------------------------------------------- sondas

# Una sola foto de `ss` por corrida: antes cada servicio (y cada proyecto de
# `all json`) ejecutaba su propio `ss`, y el sondeo de la barra se iba en decenas
# de procesos. Clave: puerto → pid (vacío si es de otro usuario).
declare -A LISTEN_PIDS=()
LISTEN_LOADED=""
load_listeners() {
    if [[ ${1:-} == force ]]; then
        LISTEN_PIDS=()
        LISTEN_LOADED=""
    elif [[ -n $LISTEN_LOADED ]]; then
        return 0
    fi
    LISTEN_LOADED=1
    local line local_addr port pid
    while IFS= read -r line; do
        local_addr=$(awk '{print $4}' <<<"$line")
        port=${local_addr##*:}
        [[ $port =~ ^[0-9]+$ ]] || continue
        pid=$(grep -oE 'pid=[0-9]+' <<<"$line" 2>/dev/null | head -1 | cut -d= -f2 || true)
        LISTEN_PIDS[$port]=${pid:-}
    done < <(ss -ltnpH 2>/dev/null || true)
}

port_open() { load_listeners; [[ -n ${LISTEN_PIDS[$1]+x} ]]; }
# Para las esperas: el servicio acaba de arrancar, la foto anterior ya no vale.
port_open_fresh() { load_listeners force; [[ -n ${LISTEN_PIDS[$1]+x} ]]; }

# PID dueño de un puerto (visible si el proceso es del mismo usuario). Siempre
# termina en 0: sin match no debe tumbar el script (set -e).
port_owner() { load_listeners; printf '%s' "${LISTEN_PIDS[$1]:-}"; }

# Los sondeos de la barra no pueden esperar 5 s por un servicio que escucha y
# no contesta. 1 s alcanza para un health local; las acciones que esperan de
# verdad usan 5 s explícitos en report_ready.
http_code() {
    curl -sS -o /dev/null --connect-timeout 1 -m "${2:-1}" -w '%{http_code}' "$1" 2>/dev/null \
        || printf '000'
}
http_ok() { [[ "$(http_code "$1" "${2:-1}")" =~ ^[23] ]]; }

# Un servicio que muere porque falta instalar dependencias es el error más común
# al declarar un repo recién clonado; el log lo dice, así que se lo traducimos.
dependency_hint() {
    local id=$1 dir=$2 log
    log=$(svc_logfile "$id")
    [[ -r $log ]] || return 0
    grep -qE "command not found|MODULE_NOT_FOUND|Cannot find module|failed to run command" "$log" || return 0
    [[ -r $dir/package.json ]] || return 0
    [[ -d $dir/node_modules ]] && return 0
    printf 'faltan dependencias: probá "npm install" en %s' "$dir"
}

pid_of_file() {
    local f=$1 pid
    [[ -r $f ]] || return 1
    pid=$(<"$f")
    [[ $pid =~ ^[0-9]+$ ]] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    printf '%s' "$pid"
}

# ---------------------------------------------------------------- propiedad
# Un puerto tiene dueño, no sólo un proceso escuchando. Cada servicio deja un
# claim con su proyecto y su pid (o contenedor); así `up`/`down` distinguen "mi
# servicio", "el servicio de otro proyecto" y "un proceso suelto". Sin esto,
# dos configs en :3001 se contestaban cruzado y bajar una dejaba la otra a
# medias.

svc_claimfile() { printf '%s/%s.claim' "$RUNTIME_DIR" "$1"; }

write_claim() { # id puerto pid contenedor proyecto-compose
    local id=$1 port=$2 pid=$3 container=$4 compose_project=$5 file tmp
    ensure_runtime 2>/dev/null || return 0
    mkdir -p "$RUNTIME_DIR" 2>/dev/null || return 0
    file=$(svc_claimfile "$id")
    tmp="$file.tmp.$$"
    jq -nc --arg project "$CURRENT" --arg service "$id" --argjson port "${port:-0}" \
        --arg pid "$pid" --arg container "$container" --arg compose_project "$compose_project" \
        --argjson at "$(date +%s)" \
        '{project:$project, service:$service, port:$port, pid:$pid, container:$container, compose_project:$compose_project, at:$at}' \
        >"$tmp" 2>/dev/null || { rm -f "$tmp"; return 0; }
    chmod 600 "$tmp" 2>/dev/null || true
    mv -f "$tmp" "$file" 2>/dev/null || rm -f "$tmp"
}

clear_claim() { rm -f "$(svc_claimfile "$1")" 2>/dev/null || true; }

claim_field() { # archivo campo
    jq -r --arg k "$2" '.[$k] // empty' "$1" 2>/dev/null || true
}

# Puertos claimados por proyectos con el proceso todavía vivo. Los claims de
# docker no tienen pid: se confían mientras el puerto siga abierto; al bajar el
# stack se borran.
declare -A CLAIM_PORT_PROJECT=()
declare -A CLAIM_PORT_AT=()
CLAIMS_LOADED=""
load_claims() {
    [[ -n $CLAIMS_LOADED ]] && return 0
    CLAIMS_LOADED=1
    local f port project pid at
    for f in "$RUNTIME_BASE"/*/*.claim; do
        [[ -r $f ]] || continue
        port=$(claim_field "$f" port)
        project=$(claim_field "$f" project)
        pid=$(claim_field "$f" pid)
        at=$(claim_field "$f" at)
        [[ -n $port && -n $project ]] || continue
        if [[ -n $pid ]]; then
            kill -0 "$pid" 2>/dev/null || continue
        fi
        # Si quedó un claim viejo del mismo puerto (un contenedor que paraste a
        # mano), gana el más reciente: es el que acaba de escribir su dueño.
        [[ ${at:-0} =~ ^[0-9]+$ ]] || at=0
        if [[ -z ${CLAIM_PORT_PROJECT[$port]:-} ]] || ((at >= ${CLAIM_PORT_AT[$port]:-0})); then
            CLAIM_PORT_PROJECT[$port]=$project
            CLAIM_PORT_AT[$port]=$at
        fi
    done
}

claim_project_for_port() { load_claims; printf '%s' "${CLAIM_PORT_PROJECT[$1]:-}"; }

# Dueño de un puerto abierto: primero los claims (proceso o contenedor de un
# proyecto devstack) y, si no hay, el cwd del proceso que escucha. Un `node`
# lanzado a mano dentro de ~/Projects/MeperPOS/:3001 es de MeperPOS aunque no
# tenga pidfile.
port_owner_project() {
    local port=$1 owner pid cwd
    owner=$(claim_project_for_port "$port")
    [[ -n $owner ]] && { printf '%s' "$owner"; return 0; }
    pid=$(port_owner "$port")
    [[ -n $pid && -d /proc/$pid ]] || return 1
    cwd=$(readlink -f "/proc/$pid/cwd" 2>/dev/null) || return 1
    [[ -n $cwd ]] || return 1
    project_for_path "$cwd"
}

# Otro proyecto declarado que usa ese puerto (aunque esté abajo): sirve para no
# volver a caer en la misma colisión la próxima vez.
declared_project_for_port() {
    local port=$1 p f
    for p in $(list_user_projects); do
        [[ $p == "$CURRENT" ]] && continue
        f=$(project_file "$p") || continue
        if jq -e --argjson port "$port" '[.services[]? | select(.port == $port)] | length > 0' \
            "$f" >/dev/null 2>&1; then
            printf '%s' "$p"
            return 0
        fi
    done
    return 1
}

# Resultado de la última acción con `up`/`down`/`restart`: el widget lo lee en
# `json` (lastResult) para saber cuándo terminó.
on_exit() {
    local rc=$?
    [[ -n $ACTION ]] || return 0
    [[ -n $RUNTIME_DIR ]] || return 0
    mkdir -p "$RUNTIME_DIR" 2>/dev/null || return 0
    local ok=false detail=${LAST_DETAIL:-}
    [[ $rc == 0 ]] && ok=true
    [[ -n $detail ]] || detail=$( [[ $ok == true ]] && printf 'listo' || printf 'falló' )
    printf '{"action":"%s","ok":%s,"at":%s,"detail":"%s"}\n' "$ACTION" "$ok" "$(date +%s)" \
        "$(printf '%s' "$detail" | tr -d '"\\' | cut -c1-160)" >"$RUNTIME_DIR/result.json" 2>/dev/null || true
}
trap on_exit EXIT

# ---------------------------------------------------------------- config

list_projects() {
    local dir f name seen=""
    for dir in "${CONFIG_DIRS[@]}"; do
        for f in "$dir"/*.json; do
            [[ -r $f ]] || continue
            name=$(basename "$f" .json)
            [[ " $seen " == *" $name "* ]] && continue
            seen="$seen $name"
            printf '%s\n' "$name"
        done
    done
}

# Ruta del config de un proyecto: se busca en orden (usuario primero).
project_file() {
    local name=$1 dir
    for dir in "${CONFIG_DIRS[@]}"; do
        [[ -r "$dir/$name.json" ]] && {
            printf '%s' "$dir/$name.json"
            return 0
        }
    done
    return 1
}

# Proyecto "de casa": el que guarda `devstack use`. Si el archivo apunta a un
# proyecto que ya no existe devuelve error en vez de morir: lo usan `here` y el
# widget, donde caerse no es opción.
default_project() {
    local f="$USER_CONFIG_DIR/default" name
    [[ -r $f ]] || return 1
    name=$(<"$f")
    [[ -n $name ]] || return 1
    project_file "$name" >/dev/null || return 1
    printf '%s' "$name"
}

use_cmd() {
    local f="$USER_CONFIG_DIR/default" want="${1:-}" cur
    case $want in
        --help | -h)
            printf 'devstack use [PROYECTO|--clear]\n'
            printf '  sin argumentos  muestra el proyecto de casa\n'
            printf '  PROYECTO        lo guarda (el widget lo usa cuando la terminal no está\n'
            printf '                  en ningún proyecto declarado)\n'
            printf '  --clear         lo olvida y vuelve a depender de la lectura automática\n'
            return 0
            ;;
        --clear)
            rm -f "$f"
            ok "Sin proyecto de casa: el widget vuelve a seguir la terminal"
            return 0
            ;;
        "")
            if cur=$(default_project); then
                printf '%s\n' "$cur"
            elif [[ -r $f ]]; then
                warn "El proyecto guardado ('$(<"$f")') ya no existe: corré 'devstack use --clear'"
                return 1
            else
                printf 'Sin proyecto de casa\n'
            fi
            return 0
            ;;
    esac
    project_file "$want" >/dev/null || die "No existe el proyecto '$want' (busqué en ${CONFIG_DIRS[*]})"
    mkdir -p "$USER_CONFIG_DIR"
    printf '%s\n' "$want" >"$f"
    ok "Proyecto de casa: $want (el widget lo usa cuando no reconoce la terminal)"
}

# El pin del widget es OTRA cosa que el proyecto de casa: `use` es el fallback
# de `here`, mientras que `pin` obliga a la barra a mostrar ese proyecto aunque
# el foco esté en otro. Antes el botón de fijar escribía `use`, así que fijar y
# despinar cambiaban también el default del CLI. Ahora vive en su archivo.
pin_file() { printf '%s/pinned' "$USER_CONFIG_DIR"; }

pinned_project() {
    local f name
    f=$(pin_file)
    [[ -r $f ]] || return 0
    name=$(tr -d '\n\r' <"$f")
    [[ -n $name ]] || return 0
    if ! project_file "$name" >/dev/null 2>&1; then
        rm -f "$f" 2>/dev/null || true
        return 0
    fi
    printf '%s' "$name"
}

pin_cmd() {
    local f want="${1:-}" cur
    f=$(pin_file)
    case $want in
        --help | -h)
            printf 'devstack pin [PROYECTO|--clear|--show]\n'
            printf '  sin argumentos o --show  muestra el proyecto fijado\n'
            printf '  PROYECTO                  lo fija en la barra (ignora el foco)\n'
            printf '  --clear                   vuelve a seguir el foco\n'
            return 0
            ;;
        --clear)
            rm -f "$f"
            ok "Sin proyecto fijado: la barra vuelve a seguir la terminal"
            return 0
            ;;
        "" | --show)
            cur=$(pinned_project)
            [[ -n $cur ]] && printf '%s\n' "$cur"
            return 0
            ;;
    esac
    project_file "$want" >/dev/null || die "No existe el proyecto '$want' (busqué en ${CONFIG_DIRS[*]})"
    mkdir -p "$USER_CONFIG_DIR"
    printf '%s\n' "$want" >"$f"
    ok "Proyecto fijado en la barra: $want"
}

# devstack find [DIR...] [--json] [--depth N]
# Busca en tus carpetas de proyectos los repos que devstack podría levantar:
# nombre, ruta, si ya está declarado y cuántos servicios salen. No escribe nada
# (para declarar uno: `devstack add <dir>`). Es la versión "elegí vos" del
# detector: la lista de candidatos que el widget muestra al buscar.
find_cmd() {
    local roots=() opt="" depth=2
    while [[ $# -gt 0 ]]; do
        case $1 in
            --json) opt=--json ;;
            --depth)
                shift
                depth=${1:-2}
                ;;
            -*) die "find: opción desconocida $1" ;;
            *) roots+=("$1") ;;
        esac
        shift
    done
    if ((${#roots[@]} == 0)); then
        # DEVDATA_SEARCH_ROOTS con ':' separa varias carpetas.
        IFS=':' read -r -a roots <<<"${DEVDATA_SEARCH_ROOTS:-$HOME/Projects}"
    fi
    require_scan
    # Dónde están TUS proyectos ya declarados: un directorio que ya es un
    # proyecto (o vive dentro de uno) no se propone como candidato aparte.
    local decl_paths=() decl_names=() p d i
    while IFS= read -r p; do
        [[ -n $p ]] || continue
        d=$(jq -r '.dir // ""' "$(project_file "$p")" 2>/dev/null)
        d="${d/#\~/$HOME}"
        d=$(cd "$d" 2>/dev/null && pwd) || d="${d%/}"
        [[ -n $d ]] || continue
        decl_paths+=("$d")
        decl_names+=("$p")
    done < <(list_user_projects)

    local root dir json rows="[]" entry name label declared skipped candidates=() prev n
    for root in "${roots[@]}"; do
        [[ -d $root ]] || continue
        root=$(cd "$root" && pwd)
        while IFS= read -r dir; do
            # Si ya acepté la carpeta madre, sus hijos no son otro proyecto.
            for prev in ${candidates[@]+"${candidates[@]}"}; do
                [[ $dir == "$prev"/* ]] && continue 2
            done

            declared=""
            skipped=""
            for ((i = 0; i < ${#decl_paths[@]}; i++)); do
                if [[ $dir == "${decl_paths[$i]}" ]]; then
                    declared="${decl_names[$i]}"
                    break
                fi
                if [[ $dir == "${decl_paths[$i]}"/* ]]; then
                    skipped=1
                    break
                fi
            done
            [[ -n $skipped ]] && continue

            rel=${dir#"$root"/}
            if [[ -n $declared ]]; then
                # Ya declarado: su estado (y sus servicios) salen del proyecto,
                # no del detector. Se acepta acá y se podan sus hijos.
                candidates+=("$dir")
                entry=$(project_snapshot "$declared" | jq -c --arg dir "$dir" --arg l "$rel" --arg b "$(basename "$dir")" --arg d "$declared" \
                    '{name: .name, dir: $dir, rel: $l, base: $b, label: $l, suggested: $d, declared: true, project: $d,
                      services: .services, docker: 0, up: .up, total: .total, allUp: .allUp}')
            else
                # El detector decide: si de acá salen servicios, es un proyecto
                # (aunque su stack viva en backend/ y frontend/).
                json=$(scan_project_json "$dir" "" 2>/dev/null | grep -v '^#') || continue
                [[ -n $json ]] || continue
                n=$(printf '%s' "$json" | jq '.services | length')
                ((n > 0)) || continue
                # Un candidato tiene que parecer un repo (marcador en la raíz) o
                # traer un stack de verdad (2+ servicios): así un directorio
                # contenedor con un solo service suelto no se come a los
                # proyectos que tiene adentro.
                if ((n < 2)) && ! looks_like_repo "$dir"; then continue; fi
                name=$(sanitize_name "$rel")
                candidates+=("$dir")
                entry=$(printf '%s' "$json" | jq -c --arg dir "$dir" --arg l "$rel" --arg b "$(basename "$dir")" --arg p "$name" \
                    '{name: (.name // $p), dir: $dir, rel: $l, base: $b, label: $l, suggested: $p, declared: false, project: "",
                      services: [.services[]? | {id: .id, label: .label, type: .type, port: .port}],
                      docker: ([.services[]? | select(.type == "docker")] | length), up: 0, total: 0, allUp: false}')
            fi
            rows=$(printf '%s' "$rows" | jq -c --argjson e "$entry" '. + [$e]')
        done < <(find "$root" -mindepth 1 -maxdepth "$depth" -type d \
            -not -path '*/.git*' -not -path '*/node_modules*' -not -path '*/dist*' \
            -not -path '*/.next*' -not -path '*/build*' -not -path '*/target*' \
            -not -path '*/vendor*' -not -path '*/.venv*' -not -path '*/__pycache__*' 2>/dev/null | sort)
    done

    # El nombre corto (el de la carpeta) manda cuando no se repite: "backend" y
    # "frontend" de dos repos se distinguen solos, y "Proyecto de Grado/
    # gestion-inventario-app" se muestra como "gestion-inventario-app".
    # El nombre corto manda si no se repite; si se repite, la ruta dentro de la
    # carpeta buscada; si tampoco alcanza (dos carpetas buscadas), la ruta entera.
    rows=$(printf '%s' "$rows" | jq -c '
        (map(.base // "") | group_by(.) | map({key: .[0], value: length}) | from_entries) as $b
        | (map(.rel // "") | group_by(.) | map({key: .[0], value: length}) | from_entries) as $r
        | map(if .declared then .
              else ((if ($b[.base] // 0) > 1
                     then (if ($r[.rel] // 0) > 1 then .dir else .rel end)
                     else .base end) as $l
                    | . + {label: $l,
                           suggested: ($l | ascii_downcase | gsub("[^a-z0-9._-]"; "-")
                                       | sub("^-+"; "") | sub("-+$"; ""))})
              end)')

    # Primero los que ya podés levantar, después los que traen más servicios.
    rows=$(printf '%s' "$rows" | jq -c 'sort_by([(if .declared then 0 else 1 end), (if .declared then 0 else -(.services | length) end), (.label // "")])')
    if [[ $opt == --json ]]; then
        printf '%s\n' "$rows"
        return 0
    fi
    if [[ $(printf '%s' "$rows" | jq 'length') -eq 0 ]]; then
        warn "No encontré repos con stack en: ${roots[*]}"
        return 1
    fi
    printf '%s' "$rows" | jq -r '.[] |
        [(if .declared then "declarado" else "sin declarar" end), .label,
         (if .declared then ((.total | tostring) + " serv.") else ((.services | length) | tostring) + " serv." end),
         (if .docker > 0 then "docker" else "" end), .dir] | @tsv' \
        | column -t -s$'\t'
    printf '\nPara declarar uno: devstack add <ruta>  ·  para levantarlo ya: devstack add <ruta> && devstack <nombre> up\n'
}

# devstack lang [en|es] — idioma del widget. Vive en un archivo de una línea
# (~/.config/devstack/lang) que el panel lee al arrancar; el widget tiene un
# botoncito que lo cambia, y esto es la misma cosa desde la terminal.
lang_cmd() {
    local f="$USER_CONFIG_DIR/lang" want="${1:-}"
    case $want in
        "") cat "$f" 2>/dev/null || printf 'en\n' ;;
        en | es)
            mkdir -p "$USER_CONFIG_DIR"
            printf '%s\n' "$want" >"$f"
            ok "Idioma del widget: $want"
            ;;
        *) die "lang: usá 'en' o 'es'" ;;
    esac
}

resolve_project() {
    local want="${1:-$DEFAULT_PROJECT}" all=()
    if [[ -z $want ]]; then
        while IFS= read -r p; do [[ -n $p ]] && all+=("$p"); done < <(list_projects)
        case ${#all[@]} in
            0) die "No hay proyectos: corré 'devstack init NOMBRE' o poné un .json en $USER_CONFIG_DIR" ;;
            1) want="${all[0]}" ;;
            *)
                if [[ -r $USER_CONFIG_DIR/default ]]; then
                    want=$(<"$USER_CONFIG_DIR/default")
                else
                    die "Hay varios proyectos (${all[*]}): pasá el nombre o corré 'devstack use <nombre>'"
                fi
                ;;
        esac
    fi
    project_file "$want" >/dev/null || die "No existe el proyecto '$want' (busqué en ${CONFIG_DIRS[*]})"
    printf '%s' "$want"
}

load_project() {
    CURRENT=$(resolve_project "${1:-}")
    CONFIG_FILE=$(project_file "$CURRENT")
    command -v jq >/dev/null || die "Falta jq (pacman -S jq)"
    DEVDATA_NAME=$(jq -r '.name // env.DEVDATA_NAME // "devstack"' "$CONFIG_FILE")
    DIR=$(jq -r '.dir // "."' "$CONFIG_FILE")
    DIR="${DIR/#\~/$HOME}"
    RUNTIME_DIR="$RUNTIME_BASE/$CURRENT"
    [[ -d $DIR ]] || warn "El directorio del proyecto no existe: $DIR"
}

# Lee un campo de un servicio: svc_field <id> <campo>
svc_field() {
    jq -r --arg id "$1" --arg k "$2" '.services[] | select(.id == $id) | .[$k] // empty' "$CONFIG_FILE"
}
svc_ids() { jq -r '.services[].id' "$CONFIG_FILE"; }
svc_index() { jq -r --arg id "$1" '.services | to_entries[] | select(.value.id == $id) | .key' "$CONFIG_FILE"; }

svc_label() { local l; l=$(svc_field "$1" label); printf '%s' "${l:-$1}"; }
svc_port() { svc_field "$1" port; }
svc_type() { local t; t=$(svc_field "$1" type); printf '%s' "${t:-process}"; }
svc_pidfile() { printf '%s/%s.pid' "$RUNTIME_DIR" "$1"; }
svc_logfile() { printf '%s/%s.log' "$RUNTIME_DIR" "$1"; }

# Une un directorio base con el valor declarado, respetando rutas absolutas.
join_dir() {
    local base=$1 value=$2
    if [[ -z $value ]]; then
        printf '%s' "$base"
    elif [[ $value == /* ]]; then
        printf '%s' "$value"
    else
        printf '%s/%s' "$base" "$value"
    fi
}

# Ruta absoluta de un campo de directorio del servicio, relativa al proyecto.
svc_dir() {
    join_dir "$DIR" "$(svc_field "$1" dir)"
}

docker_needed() {
    local id
    for id in $(svc_ids); do
        [[ $(svc_type "$id") == docker ]] && return 0
    done
    return 1
}

# ---------------------------------------------------------------- docker

DOCKER=()
docker_resolved=""
resolve_docker() {
    [[ -n $docker_resolved ]] && return 0
    command -v docker >/dev/null || die "Docker no está instalado"
    if command -v omarchy-sudo-docker >/dev/null 2>&1 && omarchy-sudo-docker 2>/dev/null; then
        # Sin grupo docker el socket es root: con terminal pide la contraseña
        # sudo; sin terminal (barra/menú) usa el diálogo de polkit de Omarchy.
        if [[ -t 0 ]]; then
            command -v sudo >/dev/null || die "Falta sudo"
            DOCKER=(sudo docker)
        else
            command -v pkexec >/dev/null || die "Falta pkexec (paquete polkit)"
            DOCKER=(pkexec docker)
        fi
    else
        DOCKER=(docker)
    fi
    docker_resolved=1
}

dockerq() { resolve_docker; "${DOCKER[@]}" "$@"; }

# Lectura de estado sin elevar: ni status ni la barra deben abrir un diálogo.
docker_quiet() {
    if command -v omarchy-sudo-docker >/dev/null 2>&1 && omarchy-sudo-docker 2>/dev/null; then
        if sudo -n true 2>/dev/null; then sudo docker "$@"; else return 1; fi
    else
        docker "$@"
    fi
}

compose_source() {
    local id=$1 file
    file=$(svc_field "$id" compose)
    [[ -n $file ]] || die "El servicio docker '$id' necesita 'compose'"
    [[ $file == /* ]] || file="$DIR/$file"
    printf '%s' "$file"
}

# Nombre de proyecto compose propio: dos stacks con un compose parecido (mismo
# nombre de carpeta, mismo `container_name`) dejaban de compartir contenedor,
# red y volumen. Ahora cada proyecto devstack tiene los suyos.
compose_project_name() {
    local name
    name=$(printf '%s' "$CURRENT" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_-' '-')
    printf 'devstack-%s' "${name:-project}"
}

compose_generated_file() { printf '%s/%s.compose.json' "$RUNTIME_DIR" "$1"; }
compose_service_file() { printf '%s/%s.compose-service' "$RUNTIME_DIR" "$1"; }

# Genera un compose equivalente al declarado, pero aislado:
#   · proyecto devstack-<proyecto> (redes y volúmenes propios)
#   · sin container_name fijo (dos proyectos no se pelean el nombre)
#   · el primer puerto publicado del servicio pasa al puerto que declara devstack
# `docker compose config` no habla con el daemon: no pide contraseña.
ensure_compose_file() {
    local id=$1 file gen svc container only json project port
    file=$(compose_source "$id")
    gen=$(compose_generated_file "$id")
    project=$(compose_project_name)
    container=$(svc_field "$id" container)
    port=$(svc_port "$id")
    mkdir -p "$RUNTIME_DIR"
    chmod 700 "$RUNTIME_DIR" 2>/dev/null || true

    command -v docker >/dev/null || die "Docker no está instalado"
    json=$( cd "$DIR" && docker compose -f "$file" config --format json 2>/dev/null ) || {
        die "No pude leer el compose de '$id' ($file)"
    }
    # Servicio del compose que corresponde a este servicio de devstack: por
    # `container` (container_name del compose) o, si hay uno solo, ése.
    svc=$(printf '%s' "$json" | jq -r --arg c "$container" '
        if $c != "" then
          ([.services | to_entries[] | select(.value.container_name == $c)][0].key // "")
        else "" end')
    if [[ -z $svc ]]; then
        only=$(printf '%s' "$json" | jq -r '.services | keys | if length == 1 then .[0] else empty end')
        if [[ -n $only ]]; then
            svc=$only
        elif [[ -n $container ]]; then
            die "El container '$container' no está en $file (revisá 'container' en el config de $CURRENT)"
        else
            die "El compose de '$id' tiene varios servicios: declarale 'container' para saber cuál es"
        fi
    fi

    printf '%s' "$json" | jq --arg name "$project" --arg svc "$svc" --argjson port "${port:-0}" '
        .name = $name
        | .services |= with_entries(
            .value |= del(.container_name)
            | if .key == $svc and $port > 0 then
                .value.ports = ((.value.ports // []) | if length > 0 then
                    .[0].published = ($port | tostring) | . else . end)
              else . end
          )
        | .volumes = ((.volumes // {}) | with_entries(
            if (.value.external // false) then . else .value.name = ($name + "_" + .key) end))
        | .networks = ((.networks // {}) | with_entries(
            if (.value.external // false) then . else .value.name = ($name + "_" + .key) end))
      ' >"$gen" || die "No pude generar el compose aislado de '$id'"
    chmod 600 "$gen" 2>/dev/null || true
    printf '%s\n' "$svc" >"$(compose_service_file "$id")"
}

compose_up() {
    local id=$1 project svc cid cname port
    ensure_runtime
    ensure_compose_file "$id"
    project=$(compose_project_name)
    svc=$(<"$(compose_service_file "$id")")
    port=$(svc_port "$id")
    resolve_docker
    ( cd "$DIR" && "${DOCKER[@]}" compose -p "$project" -f "$(compose_generated_file "$id")" up -d ) \
        || die "docker compose up falló para $(svc_label "$id")"
    # Nombre real del contenedor (sin container_name fijo lo pone compose):
    # el claim es lo que usa el estado para no confundirlo con otro stack.
    cid=$( cd "$DIR" && "${DOCKER[@]}" compose -p "$project" -f "$(compose_generated_file "$id")" ps -q "$svc" 2>/dev/null | head -1 )
    cname=""
    if [[ -n $cid ]]; then
        cname=$("${DOCKER[@]}" inspect -f '{{.Name}}' "$cid" 2>/dev/null | sed 's#^/##' | head -1)
    fi
    write_claim "$id" "$port" "" "$cname" "$project"
}

compose_down() {
    local id=$1 force=${2:-} project source
    project=$(compose_project_name)
    [[ -r $(compose_generated_file "$id") ]] || ensure_compose_file "$id"
    resolve_docker
    ( cd "$DIR" && "${DOCKER[@]}" compose -p "$project" -f "$(compose_generated_file "$id")" down ) \
        || die "docker compose down falló para $(svc_label "$id")"
    # Un contenedor viejo, creado antes del aislamiento, no lleva las labels de
    # devstack-<proyecto>. Sólo el apagado forzado lo limpia; el compose original
    # nunca se modifica.
    if [[ $force == force ]]; then
        source=$(compose_source "$id")
        log "Limpiando el compose sin aislar de $(svc_label "$id")..."
        ( cd "$DIR" && "${DOCKER[@]}" compose -f "$source" down ) >/dev/null 2>&1 || true
    fi
    clear_claim "$id"
}

container_status() {
    local id=$1 name claim
    claim=$(svc_claimfile "$id")
    if [[ -r $claim ]]; then
        name=$(claim_field "$claim" container)
    fi
    [[ -n $name ]] || name=$(svc_field "$id" container)
    [[ -n $name ]] || return 0
    docker_quiet ps -a --filter "name=^/${name}\$" --format '{{.Status}}' 2>/dev/null | head -1 || true
}

# ---------------------------------------------------------------- esperas

scaled() { printf '%s' "$(( $1 * WAIT_SCALE ))"; }

wait_for_port() {
    local port=$1 timeout=$2 label=$3 i=0
    port_open "$port" && { ok "$label ya escuchaba en :$port"; return 0; }
    log "Esperando $label en :$port (hasta ${timeout}s)..."
    while ((i < timeout)); do
        if port_open_fresh "$port"; then
            ok "$label escuchando en :$port"
            return 0
        fi
        sleep 1
        i=$((i + 1))
    done
    return 1
}

wait_for_http() {
    local url=$1 timeout=$2 label=$3 i=0
    log "Esperando $label ($url) hasta ${timeout}s..."
    while ((i < timeout)); do
        if http_ok "$url"; then
            ok "$label responde"
            return 0
        fi
        sleep 1
        i=$((i + 1))
    done
    return 1
}

wait_port_closed() {
    local port=$1 i=0
    while ((i < 15)); do
        port_open_fresh "$port" || return 0
        sleep 0.5
        i=$((i + 1))
    done
    return 1
}

tail_log() {
    [[ -s $1 ]] || return 0
    printf '\033[1;33m--- últimas líneas de %s ---\033[0m\n' "$1" >&2
    tail -n 25 "$1" >&2
}

# ---------------------------------------------------------------- procesos

start_process() {
    local id=$1 label=$2 dir=$3 port=$4
    shift 4
    ensure_runtime
    mkdir -p "$RUNTIME_DIR"
    chmod 700 "$RUNTIME_DIR"
    local logfile pidfile
    logfile=$(svc_logfile "$id")
    pidfile=$(svc_pidfile "$id")
    : >"$logfile"
    rm -f "$pidfile"
    # setsid: el servicio queda en su propia sesión (pgid == pid) para poder
    # matar el árbol entero de npm en `down`.
    # El puerto va en el entorno (lo entienden next, nuxt, express…) y también
    # se puede escribir {port} en el cmd (para los que piden un flag).
    ( cd "$dir" || exit 1; PORT="$port" DEVDATA_PORT="$port" setsid nohup "$@" >>"$logfile" 2>&1 & echo $! >"$pidfile" )
    sleep 0.5
    pid_of_file "$pidfile" >/dev/null || {
        local hint
        hint=$(dependency_hint "$id" "$dir")
        tail_log "$logfile"
        [[ -n $hint ]] && warn "$hint"
        die "$label no arrancó${hint:+ — $hint}"
    }
    write_claim "$id" "$port" "$(<"$pidfile")" "" ""
    log "$label iniciado (pid $(<"$pidfile")) → $logfile"
}

stop_process() {
    local id=$1 label=$2 port=$3 pid i=0 owner
    if ! pid=$(pid_of_file "$(svc_pidfile "$id")"); then
        rm -f "$(svc_pidfile "$id")"
        clear_claim "$id"
        if [[ -n $port ]] && port_open "$port"; then
            owner=$(port_owner_project "$port") || true
            if [[ -n $owner && $owner != "$CURRENT" ]]; then
                warn "$label: :$port lo tiene $owner; no lo toco"
            else
                warn "$label escucha en :$port pero lo levantó otra cosa (una terminal tuya); no lo toco"
            fi
        else
            log "$label ya estaba detenido"
        fi
        return 0
    fi
    log "Deteniendo $label (pgid $pid)..."
    kill -TERM "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
    while ((i < 20)) && kill -0 "$pid" 2>/dev/null; do
        sleep 0.5
        i=$((i + 1))
    done
    if kill -0 "$pid" 2>/dev/null; then
        kill -KILL "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
    fi
    rm -f "$(svc_pidfile "$id")"
    clear_claim "$id"
    [[ -n $port ]] && { wait_port_closed "$port" || warn "$label sigue escuchando en :$port"; }
    ok "$label detenido"
}

managed_process() { pid_of_file "$(svc_pidfile "$1")" >/dev/null; }

# Mata el proceso ajeno que tiene el puerto (sólo con --force). Lee el grupo
# ANTES de matar: después ps ya no lo encuentra y con set -e eso terminaba el
# script en silencio.
force_free_port() {
    local port=$1 label=$2 pid pgid own_pgid can_group=1 i=0 owner
    [[ -n $port ]] || return 0
    port_open_fresh "$port" || return 0
    # --force es para procesos sueltos, no para el stack de otro proyecto: eso
    # es exactamente el cruce que estamos sacando. A ese lo mueve `up` cuando
    # le toque arrancar (o el botón de mover puerto).
    owner=$(port_owner_project "$port") || true
    if [[ -n $owner && $owner != "$CURRENT" ]]; then
        warn "$label: :$port lo tiene el proyecto '$owner'; no lo toco (movés el tuyo con 'devstack $CURRENT port --auto')"
        return 1
    fi
    pid=$(port_owner "$port")
    if [[ -z $pid ]]; then
        warn "$label: :$port está ocupado por otro usuario; no puedo liberarlo"
        return 1
    fi
    pgid=$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ' || true)
    own_pgid=$(ps -o pgid= -p $$ 2>/dev/null | tr -d ' ' || true)
    [[ $pgid =~ ^[0-9]+$ && $pgid != "$own_pgid" && $pgid != "$$" ]] || can_group=0

    log "Matando el $label ajeno (pid $pid) que tiene :$port..."
    kill -TERM "$pid" 2>/dev/null || true
    while ((i < 10)) && port_open_fresh "$port"; do
        sleep 0.5
        i=$((i + 1))
    done

    if port_open_fresh "$port" && ((can_group)); then
        log "Sigue ocupado: mando TERM al grupo $pgid"
        kill -TERM "-$pgid" 2>/dev/null || true
        i=0
        while ((i < 6)) && port_open_fresh "$port"; do
            sleep 0.5
            i=$((i + 1))
        done
    fi

    if port_open_fresh "$port"; then
        kill -KILL "$pid" 2>/dev/null || true
        ((can_group)) && kill -KILL "-$pgid" 2>/dev/null || true
        sleep 0.5
    fi

    if port_open_fresh "$port"; then
        warn "$label: :$port sigue ocupado"
        return 1
    fi
    ok "$label: :$port liberado"
}

# ---------------------------------------------------------------- servicios

svc_up() {
    local id=$1 label port type owner=""
    label=$(svc_label "$id")
    type=$(svc_type "$id")
    # El puerto pudo haberse movido (otro proyecto ya lo tenía): se relee.
    maybe_reassign_port "$id"
    port=$(svc_port "$id")

    if [[ -n $port ]] && port_open_fresh "$port"; then
        owner=$(port_owner_project "$port") || true
        if [[ -n $owner && $owner != "$CURRENT" ]]; then
            die "$label: :$port lo tiene el proyecto '$owner' (no lo pude mover solo; usá 'devstack $CURRENT port --auto')"
        fi
        if [[ $type == docker ]]; then
            local st
            st=$(container_status "$id")
            ok "$label ya escucha en :$port${st:+ (contenedor: $st)}"
        elif managed_process "$id"; then
            ok "$label ya corriendo (lo levantó este script)"
        else
            ok "$label ya escucha en :$port (lo levantaste a mano${owner:+ en $owner}); no lo toco"
        fi
        return 0
    fi

    if [[ $type == docker ]]; then
        log "Levantando $label (docker compose)..."
        compose_up "$id" || die "docker compose up falló para $label"
        wait_for_port "$port" "$(scaled "$(svc_field "$id" wait || echo 60)")" "$label" || {
            compose_logs "$id" | tail -25 >&2 || true
            die "$label no abrió :$port"
        }
        notify "$label listo (:$port)"
        return 0
    fi

    local dir wait cmd create
    dir=$(svc_dir "$id")
    wait=$(svc_field "$id" wait)
    cmd=$(svc_field "$id" cmd)
    [[ -n $cmd ]] || die "El servicio '$id' necesita 'cmd'"
    # `create` es para servicios que traen su propio directorio de trabajo
    # (el demo). Se crea 0700 y se rechaza un symlink: una ruta predecible que
    # otro usuario local pueda preparar no se usa como cwd.
    create=$(svc_field "$id" create)
    if [[ $create == true ]]; then
        [[ -L $dir ]] && die "El directorio de $label es un symlink: $dir"
        mkdir -p -m 700 "$dir" || die "No pude crear el directorio de $label: $dir"
        [[ -O $dir ]] || die "$dir no es mío; no escribo ahí"
        chmod 700 "$dir" 2>/dev/null || true
    fi
    [[ -d $dir ]] || die "No existe el directorio de $label: $dir"
    log "Iniciando $label ($cmd)..."
    notify "Compilando $label…"
    # {port} en el cmd: se sustituye por el puerto declarado del servicio.
    [[ -n $port ]] && cmd=${cmd//\{port\}/$port}
    # shellcheck disable=SC2086
    start_process "$id" "$label" "$dir" "$port" $cmd
    if [[ -n $port ]]; then
        wait_for_port "$port" "$(scaled "${wait:-120}")" "$label" || {
            tail_log "$(svc_logfile "$id")"
            die "$label no abrió :$port"
        }
    fi
    local health
    health=$(svc_field "$id" health)
    if [[ -n $health ]]; then
        local deadline
        deadline=$(scaled "${wait:-120}")
        wait_for_http "$health" "$deadline" "$label" || {
            tail_log "$(svc_logfile "$id")"
            die "$label no llegó a responder en ${deadline}s"
        }
        notify "$label respondiendo (:$port)"
    else
        notify "$label escuchando (:$port)"
    fi
}

compose_logs() {
    local id=$1 project
    project=$(compose_project_name)
    [[ -r $(compose_generated_file "$id") ]] || ensure_compose_file "$id"
    resolve_docker
    ( cd "$DIR" && "${DOCKER[@]}" compose -p "$project" -f "$(compose_generated_file "$id")" logs )
}

svc_down() {
    local id=$1 force=${2:-} label port type
    label=$(svc_label "$id")
    port=$(svc_port "$id")
    type=$(svc_type "$id")
    if [[ $type == docker ]]; then
        compose_down "$id" "$force" || die "docker compose down falló para $label"
        ok "$label detenido"
    else
        stop_process "$id" "$label" "$port"
    fi
}

# Servicios declarados, en orden de arranque.
all_ids() { svc_ids; }

up() {
    local force="" arg
    for arg in "$@"; do [[ $arg == --force ]] && force=1; done
    local started elapsed=/dev/null id
    started=$(date +%s)
    if [[ -n $force ]]; then
        for id in $(svc_ids); do
            { managed_process "$id" || force_free_port "$(svc_port "$id")" "$(svc_label "$id")"; } || true
        done
    fi
    for id in $(svc_ids); do
        svc_up "$id"
    done
    print_urls
    elapsed=$(( $(date +%s) - started ))
    if report_ready "$elapsed"; then
        open_url "$(open_service)"
    fi
}

down() {
    local keep="" force="" arg
    for arg in "$@"; do
        case $arg in
            --keep-docker) keep=1 ;;
            --force) force=1 ;;
        esac
    done
    if [[ -n $force ]]; then
        local id
        for id in $(svc_ids); do
            { managed_process "$id" || force_free_port "$(svc_port "$id")" "$(svc_label "$id")"; } || true
        done
    fi
    # Bajar en orden inverso; docker al final.
    local ids=() id
    while IFS= read -r id; do ids+=("$id"); done < <(svc_ids)
    local i
    for ((i = ${#ids[@]} - 1; i >= 0; i--)); do
        [[ -n $keep && $(svc_type "${ids[i]}") == docker ]] && continue
        svc_down "${ids[i]}" "${force:+force}"
    done
    ok "Listo"
    notify_result "Stack detenido"
}

restart() {
    local force="" targets=() arg started elapsed
    for arg in "$@"; do
        case $arg in
            --force) force=1 ;;
            *) targets+=("$arg") ;;
        esac
    done
    started=$(date +%s)
    if [[ ${#targets[@]} -eq 0 ]]; then
        for arg in $(svc_ids); do targets+=("$arg"); done
    fi
    if [[ -n $force ]]; then
        local id
        for id in "${targets[@]}"; do
            { managed_process "$id" || force_free_port "$(svc_port "$id")" "$(svc_label "$id")"; } || true
        done
    fi
    local id
    for id in "${targets[@]}"; do
        svc_down "$id" "${force:+force}"
        svc_up "$id"
    done
    elapsed=$(( $(date +%s) - started ))
    report_ready "$elapsed" || true
}

# ---------------------------------------------------------------- reporte

# Devuelve 0 sólo si los servicios con health responden y el resto escucha; así
# no se abre una pestaña pensando mientras el dev server compila.
report_ready() {
    local elapsed=$1 bad="" id port health
    for id in $(svc_ids); do
        port=$(svc_port "$id")
        health=$(svc_field "$id" health)
        if [[ -n $health ]]; then
            http_ok "$health" 5 || bad="$bad $(svc_label "$id")"
        elif [[ -n $port ]]; then
            port_open_fresh "$port" || bad="$bad $(svc_label "$id")"
        fi
    done
    if [[ -n $bad ]]; then
        warn "Faltó:$bad (${elapsed}s). Mirá 'devstack $CURRENT status' y los logs"
        notify_result "Stack parcial en ${elapsed}s: falta$bad"
        return 1
    fi
    local web
    web=$(open_service)
    if [[ -n $web ]]; then
        local url
        url=$(svc_field "$web" health)
        [[ -n $url ]] || url=$(svc_field "$web" url)
        if [[ -n $url ]] && ! http_ok "$url" 5; then
            ok "Stack arriba en ${elapsed}s ($(svc_label "$web") todavía no contesta la 1ª ruta)"
            notify_result "Stack arriba en ${elapsed}s: abrí $url cuando responda"
            return 1
        fi
    fi
    ok "Stack arriba en ${elapsed}s"
    notify_result "Stack arriba en ${elapsed}s"
    return 0
}

# Servicio que define el navegador: el que tenga "open": true, o el último.
open_service() {
    local id
    while IFS= read -r id; do
        [[ $(svc_field "$id" open) == true ]] && { printf '%s' "$id"; return 0; }
    done < <(svc_ids)
    svc_ids | tail -1
}

svc_url() {
    local id=$1 u
    u=$(svc_field "$id" url)
    if [[ -z $u ]]; then
        u=$(svc_field "$id" health)
    fi
    printf '%s' "$u"
}

open_url() {
    local id=$1 url
    [[ -n $id ]] || return 0
    url=$(svc_url "$id")
    [[ -n $url ]] || die "El servicio '$id' no declara url"
    log "Abriendo $url"
    if command -v omarchy-launch-browser >/dev/null 2>&1; then
        omarchy-launch-browser "$url" >/dev/null 2>&1 &
    else
        xdg-open "$url" >/dev/null 2>&1 &
    fi
}

print_urls() {
    local id url
    for id in $(svc_ids); do
        url=$(svc_url "$id")
        printf '  %-12s %s\n' "$(svc_label "$id")" "${url:-(sin url)}"
    done
}

json_escape() {
    local s=$1
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}
    s=${s//$'\n'/ }
    printf '%s' "$s"
}

svc_state() {
    local id=$1 port health up healthy managed owner conflict=false claim
    port=$(svc_port "$id")
    health=$(svc_field "$id" health)
    if [[ -n $port ]] && port_open "$port"; then up=true; else up=false; fi
    owner=""
    managed=false
    if [[ $up == true ]]; then
        owner=$(port_owner_project "$port") || true
        # El puerto puede estar abierto porque otro proyecto lo tenía primero.
        # Eso no es "mi stack arriba": se muestra el dueño y no cuenta.
        if [[ -n $owner && $owner != "$CURRENT" ]]; then
            conflict=true
            up=false
        fi
    fi
    claim=$(svc_claimfile "$id")
    if [[ -r $claim ]] && [[ $(claim_field "$claim" project) == "$CURRENT" ]]; then
        managed=true
    elif managed_process "$id"; then
        managed=true
    fi
    if [[ $up == true && -n $health ]] && http_ok "$health" 1; then healthy=true; else healthy=false; fi
    printf '%s' "{\"id\":\"$(json_escape "$(svc_field "$id" id)")\",\"label\":\"$(json_escape "$(svc_label "$id")")\",\"type\":\"$(svc_type "$id")\",\"port\":${port:-0},\"up\":$up,\"healthy\":$healthy,\"managed\":$managed,\"owner\":\"$(json_escape "$owner")\",\"conflict\":$conflict,\"health\":\"$(json_escape "$health")\",\"url\":\"$(json_escape "$(svc_url "$id")")\"}"
}

json_status() {
    local first=1 id out=""
    for id in $(svc_ids); do
        [[ $first == 1 ]] || out="$out,"
        first=0
        out="$out$(svc_state "$id")"
    done
    local last=null
    if [[ -r $RUNTIME_DIR/result.json ]] && jq -e . "$RUNTIME_DIR/result.json" >/dev/null 2>&1; then
        last=$(cat "$RUNTIME_DIR/result.json")
    fi
    printf '{"project":"%s","name":"%s","dir":"%s","services":[%s],"open":"%s","lang":"%s","pinned":"%s","lastResult":%s}\n' \
        "$(json_escape "$CURRENT")" "$(json_escape "$DEVDATA_NAME")" "$(json_escape "$DIR")" "$out" "$(open_service)" \
        "$(lang_cmd)" "$(pinned_project)" "$last"
}

status() {
    printf '%s — %s\n' "$DEVDATA_NAME" "$DIR"
    local id port health label type st owner cname
    for id in $(svc_ids); do
        label=$(svc_label "$id")
        port=$(svc_port "$id")
        type=$(svc_type "$id")
        health=$(svc_field "$id" health)
        if [[ -z $port ]] || ! port_open "$port"; then
            printf '  %-12s %-6s %s\n' "$label" "${port:+:$port}" "detenido"
            continue
        fi
        if [[ -n $health ]]; then
            if http_ok "$health" 4; then st="respondiendo"; else st="puerto abierto"; fi
        else
            st="escuchando"
        fi
        owner=$(port_owner_project "$port") || true
        if [[ $type == docker ]]; then
            # El contenedor puede ser ajeno (ya estaba arriba): sin nombre no se
            # muestra el paréntesis, que quedaba como "(contenedor: )".
            cname=$(container_status "$id")
            [[ -n $cname ]] && st="$st (contenedor: $cname)"
        elif [[ -n $owner && $owner != "$CURRENT" ]]; then
            st="$st (lo tiene el proyecto $owner)"
        elif managed_process "$id"; then
            st="$st (gestionado, pid $(<"$(svc_pidfile "$id")"))"
        elif [[ -n $owner ]]; then
            st="$st (a mano en $owner)"
        else
            local pid
            pid=$(port_owner "$port")
            st="$st (ajeno${pid:+, pid $pid})"
        fi
        local declared
        if declared=$(declared_project_for_port "$port"); then
            st="$st · :$port también lo declara $declared"
        fi
        printf '  %-12s %-6s %s\n' "$label" ":$port" "$st"
    done
    print_urls
    printf '  %-12s %s\n' "logs" "$RUNTIME_DIR"
}

logs() {
    local what="${1:-}" logfile
    if [[ -z $what ]]; then
        local id
        for id in $(svc_ids); do tail_log "$(svc_logfile "$id")"; done
        printf '  seguí uno con: devstack %s logs <id>\n' "$CURRENT" >&2
        return 0
    fi
    [[ -n $(svc_field "$what" id) ]] || die "No existe el servicio '$what' (mirá 'devstack $CURRENT list')"
    [[ $(svc_type "$what") == docker ]] && { compose_logs "$what" | tail -n 200 -f; return 0; }
    logfile=$(svc_logfile "$what")
    [[ -r $logfile ]] || die "Todavía no hay log de $(svc_label "$what") ($logfile): el servicio no arrancó"
    tail -n 200 -f "$logfile"
}

run_task() {
    local task=$1 dir cmd
    [[ -n $task ]] || die "task: falta el id"
    dir=$(jq -r --arg id "$task" '.tasks[]? | select(.id == $id) | .dir // empty' "$CONFIG_FILE")
    cmd=$(jq -r --arg id "$task" '.tasks[]? | select(.id == $id) | .cmd // empty' "$CONFIG_FILE")
    [[ -n $cmd ]] || die "No existe la tarea '$task' (mirá 'devstack $CURRENT list')"
    local d
    d=$(join_dir "$DIR" "$dir")
    local need
    while IFS= read -r need; do
        [[ -n $need ]] && svc_up "$need"
    done < <(jq -r --arg id "$task" '.tasks[]? | select(.id == $id) | .needs[]?' "$CONFIG_FILE")
    log "Tarea $task: $cmd"
    ( cd "$d" && bash -lc "$cmd" )
}

list_all() {
    printf '%s (%s)\n' "$DEVDATA_NAME" "$DIR"
    local id
    for id in $(svc_ids); do
        printf '  servicio  %-12s %s\n' "$id" "$(svc_field "$id" cmd)$(svc_field "$id" compose)"
    done
    while IFS=$'\t' read -r tid tlabel tcmd; do
        [[ -n $tid ]] && printf '  tarea     %-12s %s\n' "$tid" "${tlabel:-$tcmd}"
    done < <(jq -r '.tasks[]? | "\(.id)\t\(.label // "")\t\(.cmd)"' "$CONFIG_FILE")
}

# Nombre de proyecto a partir de un directorio (sin guiones sobrantes).
sanitize_name() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9._-' '-' | sed -e 's/^-\{1,\}//' -e 's/-\{1,\}$//'
}

# --- contexto: "¿en qué proyecto estoy parado?" ------------------------------
# Proyecto declarado que contiene esa ruta (gana el directorio más largo).
project_for_path() {
    local path=$1 dir f name best="" best_len=0 cdir
    path=$(cd "$path" 2>/dev/null && pwd) || return 1
    # Ojo: `"${arr[@]}"/*.json` sólo glob-ea el ÚLTIMO elemento del array; hay
    # que anidar los bucles por directorio.
    # Los ejemplos que viajan con el plugin (demo, example) NO cuentan como
    # "proyecto donde estás parado": sirven para probar, no para resolver rutas.
    local dirs=("$USER_CONFIG_DIR")
    [[ -n ${DEVDATA_CONFIG:-} ]] && dirs=("$DEVDATA_CONFIG" "$USER_CONFIG_DIR")
    for cdir in "${dirs[@]}"; do
        for f in "$cdir"/*.json; do
            [[ -r $f ]] || continue
            dir=$(jq -r '.dir // empty' "$f" 2>/dev/null)
            [[ -n $dir ]] || continue
            dir="${dir/#\~/$HOME}"
            dir=$(cd "$dir" 2>/dev/null && pwd) || continue
            case $path in
                "$dir" | "$dir"/*)
                    if (( ${#dir} > best_len )); then
                        best_len=${#dir}
                        best=$(basename "$f" .json)
                    fi
                    ;;
            esac
        done
    done
    [[ -n $best ]] && printf '%s' "$best" || return 1
}

# Ruta de referencia: la terminal activa (--window) o el directorio actual.
# Cwd de un pid y de sus descendientes (hasta 3 niveles). Omarchy sólo resuelve
# el terminal activo para kitty (socket) o cuando el hijo es un shell listado en
# /etc/shells; con ghostty devolvía $HOME y el foco nunca resolvía.
pid_cwds() {
    local pid=$1 depth=${2:-3} child
    [[ -n $pid && -d /proc/$pid ]] || return 0
    readlink -f "/proc/$pid/cwd" 2>/dev/null
    ((depth > 0)) || return 0
    for child in $(pgrep -P "$pid" 2>/dev/null); do
        pid_cwds "$child" "$((depth - 1))"
    done
}

# Cwd de la ventana activa, buscando en su árbol de procesos un directorio que
# sea de un proyecto declarado. Vacío si no hay nada útil: así no inventamos un
# proyecto a partir del directorio de la ventana equivocada.
window_cwd() {
    command -v hyprctl >/dev/null 2>&1 || return 0
    command -v jq >/dev/null 2>&1 || return 0
    local pid cwd
    pid=$(hyprctl activewindow -j 2>/dev/null | jq -r '.pid // empty' 2>/dev/null)
    [[ -n $pid ]] || return 0
    while IFS= read -r cwd; do
        [[ -n $cwd && -d $cwd ]] || continue
        if project_for_path "$cwd" >/dev/null 2>&1; then
            printf '%s' "$cwd"
            return 0
        fi
    done < <(pid_cwds "$pid")
    return 0
}

reference_path() {
    if [[ ${1:-} == --window ]]; then
        # Con Hyprland: ventana activa -> árbol de procesos -> lo que diga
        # Omarchy. Si la ventana no es un terminal, $HOME = "ningún proyecto".
        if command -v hyprctl >/dev/null 2>&1; then
            local cwd
            cwd=$(window_cwd)
            if [[ -n $cwd ]]; then
                printf '%s' "$cwd"
                return 0
            fi
            if command -v omarchy-cmd-terminal-cwd >/dev/null 2>&1; then
                cwd=$(omarchy-cmd-terminal-cwd 2>/dev/null)
                if [[ -d $cwd && $cwd != "$HOME" ]]; then
                    printf '%s' "$cwd"
                    return 0
                fi
            fi
            printf '%s' "$HOME"
            return 0
        fi
        # Sin Hyprland (CI, otra sesión): no hay ventana que mirar, vale el $PWD.
    fi
    printf '%s' "$PWD"
}

# Raíz del repo (o la ruta misma si no es un repo de git).
repo_root_of() {
    local path=$1 root
    root=$(git -C "$path" rev-parse --show-toplevel 2>/dev/null)
    [[ -n $root ]] && {
        printf '%s' "$root"
        return 0
    }
    printf '%s' "$path"
}

# ¿hay algo que valga la pena declarar acá? (si no, no ofrecemos nada)
looks_like_repo() {
    local root=$1
    [[ -d $root/.git ]] && return 0
    local m
    for m in package.json pyproject.toml requirements.txt go.mod Cargo.toml Gemfile composer.json \
        manage.py docker-compose.yml compose.yml docker-compose.yaml compose.yaml; do
        [[ -e $root/$m ]] && return 0
    done
    return 1
}

# devstack here [json|status|<subcomando>] [--window] [--fallback <proyecto>]
# El proyecto de la terminal activa (--window, para el widget) o el del $PWD
# (para un atajo de teclado: "levantá el stack de donde estoy parado").
# Con --fallback, si el foco no está en un repo declarado se responde con ese
# proyecto en la MISMA pasada: el widget no necesita una segunda sonda (que se
# pisaba con ésta y dejaba el estado en blanco entre sondeo y sondeo).
here() {
    local sub=json use_window="" fallback="" use_default=""
    while [[ $# -gt 0 ]]; do
        case $1 in
            --window) use_window=--window ;;
            --default) use_default=1 ;;
            --fallback)
                shift
                fallback=${1:-}
                [[ -n $fallback ]] || die "here: --fallback necesita un nombre de proyecto"
                ;;
            -*) die "here: opción desconocida $1" ;;
            *) sub=$1 ;;
        esac
        shift
    done
    local cwd repo project suggested inner
    cwd=$(reference_path "$use_window")
    repo=$(repo_root_of "$cwd")
    if project=$(project_for_path "$cwd"); then
        if [[ $sub == json ]]; then
            inner=$("$0" "$project" json)
            printf '%s' "$inner" | jq -c --arg p "$project" --arg cwd "$cwd" --arg repo "$repo" \
                '. + {mode:"auto",declared:true,project:$p,cwd:$cwd,repo:$repo}'
        else
            exec "$0" "$project" "$sub"
        fi
        return 0
    fi
    # El foco no resolvió a un proyecto declarado: respaldo del ajuste y, si no,
    # el proyecto de casa (`devstack use`). Todo en esta pasada.
    local candidate=""
    if [[ -n $fallback ]] && project_file "$fallback" >/dev/null 2>&1; then
        candidate=$fallback
    elif [[ -n $use_default ]]; then
        candidate=$(default_project) || candidate=""
    fi
    if [[ -n $candidate ]]; then
        if [[ $sub == json ]]; then
            if inner=$("$0" "$candidate" json 2>/dev/null); then
                printf '%s' "$inner" | jq -c --arg p "$candidate" --arg cwd "$cwd" --arg repo "$repo" \
                    '. + {mode:"auto",declared:true,fallback:true,project:$p,cwd:$cwd,repo:$repo}'
                return 0
            fi
        else
            exec "$0" "$candidate" "$sub"
        fi
    fi
    [[ -n $(printf '%s' "$repo") ]] || repo=""
    if [[ -z $repo || ! -d $repo ]] || ! looks_like_repo "$repo"; then
        # No hay nada que declarar (p. ej. estás en $HOME): estado neutro.
        if [[ $sub == json ]]; then
            printf '{"mode":"auto","declared":false,"project":"","name":"","repo":"","cwd":"%s","suggested":"","services":[],"open":"","urls":{}}\n' "$cwd"
            return 0
        fi
        [[ $sub == status ]] && printf 'Sin proyecto para %s\n' "$cwd" && return 0
        die "No hay ningún proyecto declarado para $cwd"
    fi
    suggested=$(sanitize_name "$(basename "$repo")")
    case $sub in
        json)
            printf '{"mode":"auto","declared":false,"project":"","name":"%s","repo":"%s","cwd":"%s","suggested":"%s","services":[],"open":"","urls":{}}\n' \
                "$(basename "$repo")" "$repo" "$cwd" "$suggested"
            ;;
        status)
            printf 'Sin declarar: %s\n  repo: %s\n  → devstack add %s\n' "$(basename "$repo")" "$repo" "$repo"
            ;;
        *)
            die "Ese repo todavía no está declarado ($repo). Corré: devstack add $repo"
            ;;
    esac
}

# --- vista global (todos TUS proyectos) --------------------------------------
# Sólo los proyectos del usuario: los ejemplos que viajan con el plugin no son
# "tus" stacks (no entran en `all` ni en la resolución de `here`).
list_user_projects() {
    local f
    for f in "$USER_CONFIG_DIR"/*.json; do
        [[ -r $f ]] || continue
        basename "$f" .json
    done
}

# Estado resumido de un proyecto (una línea JSON).
# Primer puerto libre desde uno dado: ni declarado por otro proyecto, ni ocupado.
pick_free_port() {
    local from=${1:-3000} p other f taken
    # Primero cerca del puerto actual; si el rango se acaba (p. ej. :65000), se
    # vuelve a buscar desde 3000. Así "mover el puerto" nunca se queda sin
    # opciones por estar en el borde.
    local candidates=()
    for ((p = from + 1; p <= from + 60; p++)); do candidates+=("$p"); done
    for ((p = 3000; p < 3060; p++)); do candidates+=("$p"); done
    for p in "${candidates[@]}"; do
        ((p >= 1024 && p <= 65000)) || continue
        port_open "$p" && continue
        # Ni otro servicio del MISMO proyecto (elegir el puerto del backend para
        # el frontend fue un bug real), ni lo que declare otro proyecto.
        taken=$(jq -r --argjson p "$p" '[.services[]? | select(.port == $p)] | length' "$CONFIG_FILE" 2>/dev/null)
        [[ ${taken:-0} != 0 ]] && continue
        [[ -n $(claim_project_for_port "$p") ]] && continue
        other=""
        for f in $(list_user_projects); do
            [[ $f == "$CURRENT" ]] && continue
            if jq -e --argjson p "$p" '[.services[]? | select(.port == $p)] | length > 0' \
                "$(project_file "$f")" >/dev/null 2>&1; then
                other=$f
                break
            fi
        done
        [[ -n $other ]] && continue
        printf '%s' "$p"
        return 0
    done
    return 1
}

# Escribe el puerto nuevo en el config: port, url, health y el cmd. Para docker
# el puerto del host lo publica el compose aislado que genera `compose_up`; acá
# sólo se actualiza lo que ve devstack.
port_apply() { # id viejo nuevo [dry]
    local id=$1 old=$2 new=$3 dry=${4:-} type cmd cmd_new note="" url_new health_new tmp
    type=$(svc_type "$id")
    if [[ $type == docker ]]; then
        cmd_new=""
    else
        # El cmd: {port} si ya lo tiene, el flag por npm si es un `npm run …`, o
        # el puerto literal si estaba escrito.
        cmd=$(svc_field "$id" cmd)
        cmd_new=$cmd
        if [[ $cmd == *"{port}"* ]]; then
            note="cmd ya usa {port}"
        elif [[ $cmd =~ (^|[^0-9])$old([^0-9]|$) ]]; then
            # El puerto escrito a mano (`python3 -m http.server 4810`, o
            # `--port 4810`) también se reemplaza: si no, mover el puerto dejaba
            # el servicio escuchando en el viejo.
            cmd_new=$(printf '%s' "$cmd" | sed -E "s/(^|[^0-9])$old([^0-9]|$)/\\1{port}\\2/g")
            note="cmd ahora usa {port}"
        elif [[ $cmd == *" -- "* || $cmd == *" --port "* ]]; then
            note="cmd ya pasa un puerto fijo: revisalo"
        elif [[ $cmd =~ ^(npm|pnpm|yarn|bun|bunx)[[:space:]]+(run[[:space:]]+)?[^[:space:]]+[[:space:]]*$ ]]; then
            cmd_new="$cmd -- --port {port}"
        else
            note="aviso: el cmd no declara el puerto; devstack le exporta PORT"
        fi
    fi

    url_new=$(svc_field "$id" url)
    health_new=$(svc_field "$id" health)
    [[ -n $url_new ]] && url_new=${url_new//:$old/:$new}
    [[ -n $health_new ]] && health_new=${health_new//:$old/:$new}

    if [[ -n $dry ]]; then
        printf '  %-10s :%s → :%s\n' "$id" "$old" "$new"
        [[ $type != docker ]] && printf '  %-10s %s\n' cmd "${cmd_new:-$cmd}"
        [[ -n $note ]] && printf '  %-10s %s\n' nota "$note"
        return 0
    fi

    tmp=$(mktemp)
    jq --arg id "$id" --argjson port "$new" --arg cmd "$cmd_new" \
        --arg url "$url_new" --arg health "$health_new" '
        (.services[] | select(.id == $id)) |= (
            .port = $port
            | (if ($url | length) > 0 then .url = $url else . end)
            | (if ($health | length) > 0 then .health = $health else . end)
            | (if ($cmd | length) > 0 then .cmd = $cmd else . end)
        )' "$CONFIG_FILE" >"$tmp" || {
        rm -f "$tmp"
        die "No pude reescribir $CONFIG_FILE"
    }
    cat "$tmp" >"$CONFIG_FILE"
    rm -f "$tmp"
    [[ -n $note ]] && log "$note" || true
    return 0
}

# Devstack mueve el puerto de ESTE proyecto cuando el declarado ya es de otro.
# Nunca mata ni reconfigura el stack ajeno: el otro se queda donde está.
move_service_port() { # id [motivo]
    local id=$1 why=${2:-} old new
    old=$(svc_port "$id")
    [[ -n $old && $old != 0 ]] || return 1
    new=$(pick_free_port "$old") || die "No encontré un puerto libre cerca de :$old para $(svc_label "$id")"
    port_apply "$id" "$old" "$new"
    ok "$(svc_label "$id"): :$old → :$new${why:+ ($why)}"
    log "El cambio queda en $CONFIG_FILE"
}

# Antes de levantar un servicio: si su puerto lo tiene otro proyecto (claim,
# cwd del proceso o declaración), se mueve el NUESTRO. Si el puerto lo tiene un
# proceso suelto sin dueño identificable, se deja: puede ser tu instancia a mano.
maybe_reassign_port() { # id
    local id=$1 port type owner declared
    port=$(svc_port "$id")
    [[ -n $port && $port != 0 ]] || return 0
    type=$(svc_type "$id")
    # Un servicio nuestro ya arriba no se mueve bajo los pies.
    if [[ $type != docker ]] && managed_process "$id" && port_open "$port"; then
        return 0
    fi
    if port_open "$port"; then
        owner=$(port_owner_project "$port") || true
        # Si el que escucha es de este proyecto (lo levantaste a mano en la
        # terminal), no se toca: `up` lo da por arriba.
        if [[ -n $owner && $owner == "$CURRENT" ]]; then
            return 0
        fi
        if [[ -n $owner && $owner != "$CURRENT" ]]; then
            move_service_port "$id" "lo tenía $owner"
            return 0
        fi
        # No se pudo resolver el dueño (proceso de root, docker-proxy), pero
        # otro proyecto declara ese puerto: el nuestro se mueve igual.
        if declared=$(declared_project_for_port "$port"); then
            move_service_port "$id" ":$port lo declara $declared"
            return 0
        fi
        # Docker ajeno (legacy o de otro proyecto sin claim): se mueve el nuestro.
        if [[ $type == docker ]]; then
            move_service_port "$id" ":$port ya está ocupado"
            return 0
        fi
    fi
    # Si el puerto está libre y otro proyecto lo declara, lo deja: el que
    # arranque segundo es el que se mueve. Mover los dos por las dudas rompía
    # configs que nunca chocaban.
    return 0
}

# Puerto de un servicio: devstack <p> port [<servicio>] [--to N|--auto] [--dry-run] [--force]
# Le cambia el puerto en el config (port, url y health) y, si el cmd es un
# `npm run …`, le agrega `-- --port {port}` (lo entienden vite y next), así que
# se puede correr el mismo repo dos veces o convivir con otro proyecto.
port_cmd() {
    local target="" to="" auto="" dry="" force=""
    while [[ $# -gt 0 ]]; do
        case $1 in
            --to)
                shift
                to=${1:-}
                ;;
            --auto) auto=1 ;;
            --dry-run) dry=1 ;;
            --force) force=1 ;;
            -*) die "port: opción desconocida $1" ;;
            *) target=$1 ;;
        esac
        shift
    done

    local id=$target
    if [[ -z $id ]]; then
        # Sin servicio: el que choca con otro proyecto, o el único con puerto.
        local clash
        clash=$(port_clashes | awk 'NR == 1 {print $1}' | tr -d ':')
        if [[ -n $clash ]]; then
            id=$(jq -r --argjson p "$clash" '.services[] | select(.port == $p) | .id' "$CONFIG_FILE" | head -1)
        else
            id=$(jq -r '[.services[] | select((.port // 0) > 0) | .id] | if length == 1 then .[0] else empty end' "$CONFIG_FILE")
        fi
        [[ -n $id ]] || die "Decime qué servicio (devstack $CURRENT list)"
    fi
    svc_index "$id" >/dev/null || die "No existe el servicio '$id' en $CURRENT"

    local type old new
    type=$(svc_type "$id")
    [[ $type == docker ]] && die "El puerto de '$id' lo define su compose: cambialo ahí (devstack sólo lo chequea)"
    old=$(svc_port "$id")
    [[ -n $old ]] || die "El servicio '$id' no declara puerto"

    if [[ -n $to ]]; then
        [[ $to =~ ^[0-9]+$ ]] || die "--to necesita un número"
        new=$to
        [[ $new -ge 1024 && $new -le 65000 ]] || die "Fuera de rango: $new"
        if ((new != old)) && [[ -z $force ]]; then
            port_open "$new" && die ":$new ya está escuchando (usá --force si igual querés declararlo)"
            local mine
            mine=$(jq -r --argjson p "$new" '[.services[]? | select(.port == $p) | .id] | join(",")' "$CONFIG_FILE" 2>/dev/null)
            [[ -n $mine ]] && die ":$new ya lo usa el servicio '$mine' de $CURRENT (usá --force si querés el mismo)"
            local f
            for f in $(list_user_projects); do
                [[ $f == "$CURRENT" ]] && continue
                jq -e --argjson p "$new" '[.services[]? | select(.port == $p)] | length > 0' \
                    "$(project_file "$f")" >/dev/null 2>&1 && die ":$new lo declara '$f' (usá --force si querés el mismo)"
            done
        fi
    elif [[ -n $auto || -z $to ]]; then
        new=$(pick_free_port "${old:-3000}") || die "No encontré un puerto libre cerca de ${old:-3000}"
    else
        die "port: pasá --to <n> o --auto"
    fi
    ((new != old)) || die "Ya usa :$new"

    if [[ -n $dry ]]; then
        [[ ${DEVDATA_DRY_QUIET:-} == 1 ]] && return 0
        port_apply "$id" "$old" "$new" dry
        return 0
    fi
    port_apply "$id" "$old" "$new"
    ok "$id: :$old → :$new"
    log "Se aplica al reiniciar: devstack $CURRENT restart $id"
}

# Puertos declarados por más de un proyecto tuyo: se pisan entre sí (y entonces
# el "arriba" de uno puede ser el proceso del otro).
port_clashes() {
    local p f port
    for p in $(list_user_projects); do
        f=$(project_file "$p") || continue
        # Dentro del proyecto también: si dos servicios comparten puerto, uno
        # nunca va a poder levantar (pasó: frontend y backend en :3001).
        while IFS= read -r port; do
            [[ -n $port && $port != 0 ]] || continue
            printf '%s\t%s\n' "$port" "$p"
        done < <(jq -r '[.services[]? | (.port // empty)] | group_by(.) | .[] | select(length > 1) | .[0]' "$f" 2>/dev/null)
        while IFS= read -r port; do
            [[ -n $port && $port != 0 ]] || continue
            printf '%s\t%s\n' "$port" "$p"
        done < <(jq -r '.services[]? | (.port // empty)' "$f" 2>/dev/null)
    done | sort -n | awk -F'\t' '{owners[$1] = owners[$1] " " $2; n[$1]++}
        END { for (p in n) if (n[p] > 1) printf "  :%s  lo declaran:%s\n", p, owners[p] }' | sort
}

project_snapshot() {
    local p=$1 inner last=null
    inner=$("$0" "$p" json 2>/dev/null) || return 1
    if [[ -r $RUNTIME_BASE/$p/result.json ]] && jq -e . "$RUNTIME_BASE/$p/result.json" >/dev/null 2>&1; then
        last=$(cat "$RUNTIME_BASE/$p/result.json")
    fi
    printf '%s' "$inner" | jq -c '{project: .project, name: .name, dir: .dir,
        up: ([.services[] | select(.up)] | length),
        total: (.services | length),
        allUp: (([.services[] | select(if .health != "" then .healthy else .up end)] | length) == (.services | length)),
        services: [.services[] | {id: .id, label: .label, type: .type, port: .port, up: .up, healthy: .healthy, managed: .managed, owner: .owner, conflict: .conflict}],
        conflicts: ([.services[] | select(.conflict)] | length),
        lastResult: $last}' --argjson last "$last"
}

# Para `all down`: los proyectos que ya no tenés declarados también son de
# devstack y sus pidfiles quedaban vivos (el "medio levantado" que no bajaba
# nadie porque ya no había config que lo nombrara).
stop_orphan_runtimes() {
    local dir p pf pid i any=0
    for dir in "$RUNTIME_BASE"/*/; do
        [[ -d $dir ]] || continue
        p=$(basename "$dir")
        [[ $p == all ]] && continue
        project_file "$p" >/dev/null 2>&1 && continue
        for pf in "$dir"/*.pid; do
            [[ -r $pf ]] || continue
            any=1
            pid=$(pid_of_file "$pf") || { rm -f "$pf"; continue; }
            log "Bajando resto huérfano de $p (pid $pid)"
            kill -TERM "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
            i=0
            while ((i < 10)) && kill -0 "$pid" 2>/dev/null; do sleep 0.5; i=$((i + 1)); done
            kill -0 "$pid" 2>/dev/null && { kill -KILL "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true; }
            rm -f "$pf"
        done
        # Un compose aislado de un proyecto que ya no existe también es nuestro.
        for gen in "$dir"/*.compose.json; do
            [[ -r $gen ]] || continue
            any=1
            command -v docker >/dev/null 2>&1 && docker compose -f "$gen" down >/dev/null 2>&1 || true
            rm -f "$gen" "$dir"/*.compose-service 2>/dev/null || true
        done
        rm -f "$dir"/*.claim 2>/dev/null || true
    done
    ((any)) && ok "Restos huérfanos detenidos"
    return 0
}

# devstack all [json|status|up|down [--force]]
all_cmd() {
    local sub=${1:-status} force="" p s
    shift || true
    for s in "$@"; do [[ $s == --force ]] && force=1; done
    local projects=() snaps=()
    while IFS= read -r p; do [[ -n $p ]] && projects+=("$p"); done < <(list_user_projects)
    if [[ ${#projects[@]} -eq 0 ]]; then
        if [[ $sub == down ]]; then
            stop_orphan_runtimes
            notify_result "No hay proyectos declarados; restos huérfanos detenidos"
            return 0
        fi
        die "No hay proyectos declarados (devstack add <dir> o devstack init <nombre>)"
    fi
    case $sub in
        json)
            # En paralelo: antes cada proyecto era un hijo secuencial y con un
            # health que no contestaba la barra esperaba la suma de todos.
            local tmpdir
            tmpdir=$(mktemp -d)
            for p in "${projects[@]}"; do
                ( "$0" "$p" json >"$tmpdir/$p.json" 2>/dev/null ) &
            done
            wait || true
            for p in "${projects[@]}"; do
                if [[ -s $tmpdir/$p.json ]] && jq -e . "$tmpdir/$p.json" >/dev/null 2>&1; then
                    s=$(jq -c '{project: .project, name: .name, dir: .dir,
                        up: ([.services[] | select(.up)] | length),
                        total: (.services | length),
                        allUp: (([.services[] | select(if .health != "" then .healthy else .up end)] | length) == (.services | length)),
                        services: [.services[] | {id: .id, label: .label, type: .type, port: .port, up: .up, healthy: .healthy, managed: .managed, owner: .owner, conflict: .conflict}],
                        conflicts: ([.services[] | select(.conflict)] | length),
                        lastResult: .lastResult}' "$tmpdir/$p.json")
                    snaps+=("$s")
                fi
            done
            rm -rf "$tmpdir"
            printf '[%s]\n' "$(printf '%s\n' "${snaps[@]:-}" | grep -v '^$' | paste -sd, -)"
            ;;
        status)
            printf '%-14s %-18s %-7s %s\n' PROYECTO NOMBRE ARRIBA ESTADO
            for p in "${projects[@]}"; do
                s=$(project_snapshot "$p") || continue
                printf '%-14s %-18s %-7s %s\n' "$p" \
                    "$(printf '%s' "$s" | jq -r .name)" \
                    "$(printf '%s' "$s" | jq -r '"\(.up)/\(.total)"')" \
                    "$(printf '%s' "$s" | jq -r '[.services[] | (if .conflict then "!" elif .healthy then "✓" elif .up then "~" else "·" end)] | join("")')"
            done
            # Puertos compartidos: el "arriba" de un proyecto puede ser el
            # proceso del otro (dos proyectos en :3000 se contestan cruzado).
            local clashes
            clashes=$(port_clashes)
            [[ -n $clashes ]] && printf '\n\033[1;33m[aviso]\033[0m  puertos compartidos entre proyectos:\n%s\n' "$clashes"
            ;;
        up)
            local failed=0
            for p in "${projects[@]}"; do
                log "— $p"
                "$0" "$p" up || failed=1
            done
            ((failed)) && die "Algún proyecto no quedó arriba (mirá 'devstack all status')"
            notify_result "Todos los stacks arriba"
            ;;
        down)
            local i failed=0
            for ((i = ${#projects[@]} - 1; i >= 0; i--)); do
                "$0" "${projects[$i]}" down ${force:+--force} || failed=1
            done
            stop_orphan_runtimes
            if ((failed)); then
                warn "Algún proyecto no terminó de bajar; mirá 'devstack all status'"
                notify_result "Apagado parcial: algún stack sigue arriba"
                return 1
            fi
            notify_result "Todos los stacks detenidos"
            ;;
        *) die "all: usá json|status|up|down [--force]" ;;
    esac
}

# --- detección (scan/add) ---------------------------------------------------
require_scan() {
    [[ -n $SCAN_LIB ]] || die "scan/add necesitan lib/scan.sh: usá el CLI que viene dentro del plugin (o instalá con ./install.sh)"
    [[ -n ${SCAN_LOADED:-} ]] && return 0
    # shellcheck source=/dev/null
    source "$SCAN_LIB"
    SCAN_LOADED=1
    command -v jq >/dev/null || die "scan/add necesitan jq"
}

# devstack scan [dir] [--json]
scan_cmd() {
    local dir="." opt=""
    while [[ $# -gt 0 ]]; do
        case $1 in
            --json) opt=--json ;;
            -*) die "scan: opción desconocida $1" ;;
            *) dir=$1 ;;
        esac
        shift
    done
    [[ -d $dir ]] || die "No existe el directorio: $dir"
    require_scan
    local root out json
    root=$(cd "$dir" && pwd)
    out=$(scan_project_json "$root" "") || die "No pude analizar $root"
    json=$(printf '%s\n' "$out" | grep -v '^#')
    if [[ $opt == --json ]]; then
        printf '%s\n' "$json"
        return 0
    fi
    printf '%s — %s\n' "$(printf '%s' "$json" | jq -r .name)" "$(printf '%s' "$json" | jq -r .dir)"
    if [[ $(printf '%s' "$json" | jq '.services | length') -eq 0 ]]; then
        warn "No reconocí ningún stack en ese directorio"
    else
        printf '  servicios propuestos:\n'
        printf '%s' "$json" | jq -r '.services[] | "    \(.id)\t\(.type)\t\(.dir // "")\t\(.cmd // .compose)\t:\(.port)\t\(.health // "")"' | column -t -s$'\t' | sed 's/^/  /'
    fi
    if [[ $(printf '%s' "$json" | jq '.tasks | length // 0') -gt 0 ]]; then
        printf '  tareas:\n'
        printf '%s' "$json" | jq -r '.tasks[] | "    \(.id)\t\(.cmd)"' | column -t -s$'\t' | sed 's/^/  /'
    fi
    printf '%s\n' "$out" | sed -n 's/^#\( evidencias\| comandos.*\)$/  \1/p'
    printf '%s\n' "$out" | sed -n '/^#   /s/^#   /    /p'
    printf '  → para declararlo:  devstack add %s\n' "$dir"
}

# devstack add [dir] [--name NOMBRE] [--force]
add_cmd() {
    local dir="." name="" force=""
    while [[ $# -gt 0 ]]; do
        case $1 in
            --force) force=1 ;;
            --name=*) name=${1#--name=} ;;
            --name)
                name="${2:-}"
                shift
                ;;
            -*) die "add: opción desconocida $1" ;;
            *) dir=$1 ;;
        esac
        shift
    done
    [[ -d $dir ]] || die "No existe el directorio: $dir"
    require_scan
    local root json
    root=$(cd "$dir" && pwd)
    if [[ -z $name ]]; then
        # sin el \n final: tr -c lo convertía en un guión al final del nombre
        name=$(sanitize_name "$(basename "$root")")
    fi
    [[ $name =~ ^[a-zA-Z0-9._-]+$ ]] || die "Nombre inválido: $name"
    json=$(scan_project_json "$root" "" | grep -v '^#') || die "No pude analizar $root"
    [[ $(printf '%s' "$json" | jq '.services | length') -gt 0 ]] ||
        die "No reconocí ningún stack en $root (probá 'devstack init $name' y editarlo a mano)"
    mkdir -p "$USER_CONFIG_DIR"
    local target="$USER_CONFIG_DIR/$name.json"
    if [[ -e $target && -z $force ]]; then
        # Repetir el mismo `add` sobre el mismo directorio no es un conflicto:
        # es la misma declaración (pasa al volver a elegir un candidato que ya
        # habías declarado). Conflictúa sólo si ese nombre apunta a otro lado.
        local have_dir
        have_dir=$(jq -r '.dir // empty' "$target" 2>/dev/null)
        have_dir="${have_dir/#\~/$HOME}"
        have_dir=$(cd "$have_dir" 2>/dev/null && pwd) || have_dir="${have_dir%/}"
        if [[ -n $have_dir && $have_dir == "$root" ]]; then
            ok "Ya estaba declarado: $name ($root) — seguí con 'devstack $name up'"
            return 0
        fi
        die "El nombre '$name' ya está tomado por $target (declara ${have_dir:-otro directorio}): usá --force para pisarlo, o --name <otro> para declarar este directorio con otro nombre"
    fi
    # ¿ese mismo directorio ya está declarado con otro nombre? Es el error fácil
    # (declarar dos veces el mismo repo porque el nombre no coincidía).
    local f existing="" cfg_dir
    for f in "$USER_CONFIG_DIR"/*.json; do
        [[ -r $f ]] || continue
        cfg_dir=$(jq -r '.dir // empty' "$f" 2>/dev/null)
        cfg_dir="${cfg_dir/#\~/$HOME}"
        if [[ -n $cfg_dir && $cfg_dir == "$root" ]]; then
            existing=$(basename "$f" .json)
            break
        fi
    done
    if [[ -n $existing && $existing != "$name" && -z $force ]]; then
        die "Ese directorio ya está declarado como '$existing' ($USER_CONFIG_DIR/$existing.json); usá --force si querés otro nombre"
    fi
    printf '%s\n' "$json" | jq . >"$target"
    ok "Proyecto $name declarado en $target"
    printf '%s' "$json" | jq -r '.services[] | "    \(.id)  \(.cmd // .compose)  :\(.port)"'
    printf '  revisalo y después:  devstack %s up\n' "$name"
}

# Crea un proyecto nuevo a partir del ejemplo que viaja con el plugin.
init_project() {
    local name=$1 target example
    [[ -n $name ]] || die "init: falta el nombre (devstack init mi-app)"
    [[ $name =~ ^[a-zA-Z0-9._-]+$ ]] || die "init: nombre inválido '$name'"
    mkdir -p "$USER_CONFIG_DIR"
    target="$USER_CONFIG_DIR/$name.json"
    [[ -e $target ]] && die "Ya existe $target"
    example=""
    [[ -r $BUNDLED_CONFIG_DIR/example.json ]] && example="$BUNDLED_CONFIG_DIR/example.json"
    [[ -n $example ]] || die "No encuentro el ejemplo en $BUNDLED_CONFIG_DIR"
    cp "$example" "$target"
    ok "Proyecto creado: $target"
    printf '  %s\n' "editá \"dir\" y los servicios, y después: devstack $name up"
}

# Bloque JSONC para pegar en ~/.config/omarchy/extensions/omarchy-menu.jsonc.
# Se arma con jq para que el escapado de las acciones sea correcto por
# construcción (cada action termina envuelta en '...' para bash -lc).
menu_block() {
    local prefix=${1:-dev} base
    base="${prefix}.${CURRENT}"
    jq -c --arg base "$base" --arg p "$CURRENT" --arg name "$DEVDATA_NAME" '
      def term($cmd): "omarchy-launch-terminal bash -lc " + ($cmd | @sh);
      . as $cfg
      | {
          ($base): {icon: "", label: $name},
          ($base + ".up"): {icon: "󰐊", label: "Levantar", when: ("! devstack " + $p + " --running"), action: term("devstack " + $p + " up || read -r")},
          ($base + ".status"): {icon: "󱆃", label: "Estado", action: term("devstack " + $p + " status; read -r")},
          ($base + ".open"): {icon: "󰖟", label: "Abrir en el navegador", checked: ("devstack " + $p + " --running"), action: ("devstack " + $p + " open")},
          ($base + ".restart"): {icon: "󰜉", label: "Reiniciar", action: term("devstack " + $p + " restart || read -r")},
          ($base + ".takeover"): {icon: "󰒓", label: "Tomar el control de puertos ajenos", when: ("devstack " + $p + " --foreign"), action: term("devstack " + $p + " up --force || read -r")},
          ($base + ".down"): {icon: "󰍃", label: "Bajar", when: ("devstack " + $p + " --up"), action: term("devstack " + $p + " down || read -r")},
          ($base + ".logs"): {icon: "", label: "Logs"}
        }
      + (reduce ($cfg.services[]) as $s ({}; . + {
            ($base + ".logs." + $s.id): {icon: "", label: ($s.label // $s.id), action: term("devstack " + $p + " logs " + $s.id)}
          }))
      + (if (($cfg.tasks // []) | length) > 0 then
           {($base + ".tasks"): {icon: "", label: "Tareas"}}
           + (reduce ($cfg.tasks[]) as $t ({}; . + {
                ($base + ".tasks." + $t.id): {icon: "", label: ($t.label // $t.id), action: term("devstack " + $p + " task " + $t.id + " || read -r")}
              }))
         else {} end)
    ' "$CONFIG_FILE" | jq -r 'to_entries[] | "  \"\(.key)\": \(.value | tojson),"'
}

menu_jsonc_path() {
    printf '%s/omarchy/extensions/omarchy-menu.jsonc' "${XDG_CONFIG_HOME:-$HOME/.config}"
}

# El botón Menú del widget apuntaba a dev.<proyecto>. Si esa ruta no existía,
# `omarchy menu summon` abría el menú RAÍZ de Omarchy (el bug de "se abre el
# menú de Omarchy"). Ahora se verifica y, si falta, se instala el bloque.
menu_route_present() {
    local project=$1 file
    file=$(menu_jsonc_path)
    [[ -r $file ]] || return 1
    grep -Fq "\"dev.$project\"" "$file"
}

menu_install() {
    local file tmp block check out p f backup count=0
    file=$(menu_jsonc_path)
    mkdir -p "$(dirname "$file")"
    [[ -f $file ]] || printf '{\n}\n' >"$file"
    block=$(mktemp)
    {
        printf '  // >>> devstack (generado por devstack menu --install)\n'
        for p in $(list_user_projects); do
            if out=$( ( load_project "$p"; menu_block dev ) 2>/dev/null ); then
                printf '%s\n' "$out"
                count=$((count + 1))
            else
                warn "No pude generar el menú de '$p'; lo salto" >&2
            fi
        done
        printf '  // <<< devstack\n'
    } >"$block"
    ((count > 0)) || { rm -f "$block"; die "No hay proyectos para el menú (devstack add <dir> o devstack init <nombre>)"; }

    tmp=$(mktemp)
    awk -v blockfile="$block" '
      BEGIN { block = ""; while ((getline line < blockfile) > 0) block = block line "\n" }
      /^[[:space:]]*\/\/ >>> devstack/ { skip = 1; next }
      /^[[:space:]]*\/\/ <<< devstack/ { skip = 0; next }
      skip { next }
      { n++; out[n] = $0 }
      END {
        last = 0
        for (i = n; i >= 1; i--) { t = out[i]; gsub(/[[:space:]]/, "", t); if (t == "}") { last = i; break } }
        for (i = 1; i <= n; i++) {
          if (i == last) printf "%s", block
          print out[i]
        }
      }
    ' "$file" >"$tmp"

    check=""
    for f in "$SCRIPT_DIR/../scripts/jsonc-check.py" "$SCRIPT_DIR/scripts/jsonc-check.py"; do
        [[ -r $f ]] && { check=$f; break; }
    done
    if command -v python3 >/dev/null 2>&1 && [[ -n $check ]]; then
        if ! python3 "$check" "$tmp" >/dev/null 2>&1; then
            rm -f "$tmp" "$block"
            die "El menú resultante no parsea; no toqué $file"
        fi
    fi
    backup="$file.bak.$(date +%Y%m%d-%H%M%S)"
    cp -a "$file" "$backup" 2>/dev/null || true
    cat "$tmp" >"$file"
    rm -f "$tmp" "$block"
    ok "Menú de Omarchy actualizado (backup: $backup)"
    command -v omarchy >/dev/null 2>&1 && omarchy menu refresh >/dev/null 2>&1 || true
}

menu_remove() {
    local file tmp
    file=$(menu_jsonc_path)
    [[ -r $file ]] || return 0
    tmp=$(mktemp)
    awk '
      /^[[:space:]]*\/\/ >>> devstack/ { skip = 1; next }
      /^[[:space:]]*\/\/ <<< devstack/ { skip = 0; next }
      !skip { print }
    ' "$file" >"$tmp"
    cat "$tmp" >"$file"
    rm -f "$tmp"
    ok "Sección devstack quitada del menú de Omarchy"
    command -v omarchy >/dev/null 2>&1 && omarchy menu refresh >/dev/null 2>&1 || true
}

menu_cmd() {
    local sub=${1:-} project=${2:-}
    case $sub in
        --help | -h)
            printf 'devstack menu --install            instala/actualiza el bloque de todos tus proyectos\n'
            printf 'devstack menu --ensure <proyecto>  lo instala sólo si falta dev.<proyecto>\n'
            printf 'devstack menu --remove             quita el bloque devstack\n'
            printf 'devstack <proyecto> menu           imprime el bloque JSONC de ese proyecto\n'
            ;;
        --install)
            menu_install
            ;;
        --ensure)
            [[ -n $project ]] || die "menu --ensure necesita el proyecto"
            project_file "$project" >/dev/null || die "No existe el proyecto '$project'"
            menu_route_present "$project" && return 0
            menu_install
            menu_route_present "$project" || die "Instalé el menú pero no encuentro la ruta dev.$project"
            ;;
        --remove)
            menu_remove
            ;;
        "")
            usage
            ;;
        *)
            die "menu: usá --install, --ensure <proyecto> o --remove"
            ;;
    esac
}

usage() {
    sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
}

# ---------------------------------------------------------------- dispatch

KNOWN_COMMANDS=" up down restart status json logs open task list menu init use find port lang pin compose-file --running --up --foreign "

[[ $# -gt 0 ]] || {
    list_projects
    exit 0
}

case "$1" in
    -h | --help | help)
        usage
        exit 0
        ;;
    list)
        # `devstack list` sin más lista los proyectos; con proyecto, sus servicios.
        if [[ $# -eq 1 ]]; then
            list_projects
            exit 0
        fi
        ;;
    init)
        init_project "${2:-}"
        exit 0
        ;;
    scan)
        scan_cmd "${@:2}"
        exit 0
        ;;
    here)
        here "${@:2}"
        exit 0
        ;;
    use)
        use_cmd "${2:-}"
        exit 0
        ;;
    pin)
        pin_cmd "${2:-}"
        exit 0
        ;;
    menu)
        # Opciones del menú (instalar/verificar/quitar). Sin opciones sigue
        # imprimiendo el bloque del proyecto, como siempre.
        case ${2:-} in
            --install | --ensure | --remove | --help | -h)
                menu_cmd "${@:2}"
                exit 0
                ;;
        esac
        ;;
    lang)
        lang_cmd "${2:-}"
        exit 0
        ;;
    find)
        find_cmd "${@:2}"
        exit 0
        ;;
    all)
        all_cmd "${@:2}"
        exit 0
        ;;
    add)
        add_cmd "${@:2}"
        exit 0
        ;;
esac

# `devstack <comando>` sin proyecto (así lo llama el widget de la barra): si el
# primer argumento es un comando conocido y no un proyecto existente, se usa el
# proyecto por defecto.
if [[ " $KNOWN_COMMANDS " == *" $1 "* ]] && ! project_file "$1" >/dev/null 2>&1; then
    CMD="$1"
    PROJECT_ARG=""
    shift
else
    PROJECT_ARG="$1"
    CMD="${2:-up}"
    [[ $# -gt 1 ]] && shift 2 || shift 1
fi

load_project "$PROJECT_ARG"

case "$CMD" in
    up) ACTION=up; up "$@" ;;
    down) ACTION=down; down "$@" ;;
    restart) ACTION=restart; restart "$@" ;;
    status) status ;;
    json) json_status ;;
    logs) logs "${1:-}" ;;
    open) open_url "${1:-$(open_service)}" ;;
    task) run_task "${1:-}" ;;
    list) list_all ;;
    menu) menu_block "${1:-dev}" ;;
    port) port_cmd "$@" ;;
    compose-file)
        # Compose aislado que usa `up` (para depurar el mapeo de puertos).
        [[ -n ${1:-} ]] || die "compose-file: falta el servicio docker"
        ensure_runtime
        ensure_compose_file "$1"
        cat "$(compose_generated_file "$1")"
        ;;
    --running)
        rc=0
        for id in $(svc_ids); do
            h=$(svc_field "$id" health)
            [[ -n $h ]] && { http_ok "$h" || rc=1; }
        done
        exit $rc
        ;;
    --up)
        rc=0
        for id in $(svc_ids); do
            p=$(svc_port "$id")
            [[ -n $p ]] && { port_open "$p" || rc=1; }
        done
        exit $rc
        ;;
    --foreign)
        rc=1
        for id in $(svc_ids); do
            p=$(svc_port "$id")
            [[ -n $p ]] || continue
            [[ $(svc_type "$id") == docker ]] && continue
            port_open "$p" || continue
            managed_process "$id" && continue
            owner=$(port_owner_project "$p") || true
            # El de otro proyecto no se "toma": `up` mueve el nuestro.
            [[ -n $owner && $owner != "$CURRENT" ]] && continue
            rc=0
        done
        exit $rc
        ;;
    -h | --help | help) usage ;;
    *)
        # Un id de servicio como comando: levanta sólo ese.
        if [[ -n $(svc_field "$CMD" id) ]]; then
            svc_up "$CMD"
        else
            usage >&2
            die "Comando desconocido: $CMD"
        fi
        ;;
esac
